<?xml version="1.0" encoding="utf-8"?>
<!-- MASVS M6: la app no entra en la copia de seguridad de Android (allowBackup="false").
     Por si algún dispositivo la ignora (Android 11 o anterior), se excluye todo:
     sesión de Firebase, preferencias con el rol y la base local. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
