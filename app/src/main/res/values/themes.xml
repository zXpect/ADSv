<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================================================================
         Tema principal (AndroidManifest). DayNight: sigue el modo claro u
         oscuro del teléfono; los colores ads_* cambian solos con
         values-night/colors.xml.
         =================================================================== -->
    <style name="Theme.ADSv" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Roles de color Material 3 → tokens ADS -->
        <item name="colorPrimary">@color/ads_brand</item>
        <item name="colorOnPrimary">@color/ads_on_brand</item>
        <item name="colorPrimaryContainer">@color/ads_chip_bg</item>
        <item name="colorOnPrimaryContainer">@color/ads_chip_text</item>
        <item name="colorSecondary">@color/ads_brand_text</item>
        <item name="colorOnSecondary">@color/ads_card</item>
        <item name="colorSecondaryContainer">@color/ads_chip_bg</item>
        <item name="colorOnSecondaryContainer">@color/ads_chip_text</item>
        <item name="colorTertiary">@color/ads_navy</item>
        <item name="colorOnTertiary">@color/ads_on_navy</item>
        <item name="android:colorBackground">@color/ads_surface</item>
        <item name="colorOnBackground">@color/ads_text</item>
        <item name="colorSurface">@color/ads_card</item>
        <item name="colorOnSurface">@color/ads_text</item>
        <item name="colorSurfaceVariant">@color/ads_surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/ads_muted</item>
        <item name="colorOutline">@color/ads_control</item>
        <item name="colorOutlineVariant">@color/ads_line</item>
        <item name="colorError">@color/error_color</item>
        <!-- Atributos heredados de Material 2 que aún leen algunas vistas -->
        <item name="colorPrimaryDark">@color/ads_brand_text</item>
        <item name="colorAccent">@color/ads_brand</item>

        <!-- Ventana y barras del sistema -->
        <item name="android:windowBackground">@color/ads_surface</item>
        <item name="android:statusBarColor">@color/ads_surface</item>
        <item name="android:windowLightStatusBar">@bool/ads_light_status_bar</item>
        <!-- Barra de navegación del sistema del color de la barra inferior (sin franja
             gris o negra debajo). Antes de Android 8.1 queda negra: no hay íconos oscuros. -->
        <item name="android:navigationBarColor">@color/ads_nav_bar</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/ads_light_status_bar</item>
        <!-- Transición uniforme al abrir y cerrar pantallas (las pestañas siguen sin animación) -->
        <item name="android:windowAnimationStyle">@style/Animation.ADS.Activity</item>

        <!-- Tipografía Sora. No se pone fontFamily directo en el tema: anularía
             los pesos 600/800 de los TextAppearance. Va como apariencia base. -->
        <item name="android:textViewStyle">@style/Widget.ADS.TextView</item>
        <item name="android:textAppearance">@style/TextAppearance.ADS.Base</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.ADS.Base</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.ADS.Wordmark</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.ADS.Headline</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.ADS.Headline</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.ADS.Title</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.ADS.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.ADS.Subtitle</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.ADS.BodySmall.Strong</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.ADS.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.ADS.BodySmall</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.ADS.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.ADS.Button</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.ADS.Label</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.ADS.Label</item>

        <!-- Estilos por defecto de los componentes -->
        <item name="materialButtonStyle">@style/Widget.ADS.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.ADS.Button.Secondary</item>
        <item name="textInputStyle">@style/Widget.ADS.TextField</item>
        <item name="materialCardViewStyle">@style/Widget.ADS.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.ADS.BottomNav</item>
        <item name="chipStyle">@style/Widget.ADS.Chip.Filter</item>
        <item name="snackbarStyle">@style/Widget.ADS.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.ADS.Snackbar.Text</item>
        <item name="snackbarButtonStyle">@style/Widget.ADS.Snackbar.Action</item>
        <!-- Diálogos de confirmación con el diseño ADS (DEF-22) -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ADS.Dialog</item>
        <!-- Selectores de fecha y hora de la agenda con el mismo fondo (DEF-29) -->
        <item name="materialCalendarTheme">@style/ThemeOverlay.ADS.Calendar</item>
        <item name="materialTimePickerTheme">@style/ThemeOverlay.ADS.TimePicker</item>
    </style>

    <!-- Fondo de tarjeta ADS, sin el tinte que Material 3 suma por la elevación -->
    <style name="ThemeOverlay.ADS.Calendar" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorSurface">@color/ads_card</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="ThemeOverlay.ADS.TimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorSurface">@color/ads_card</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <!-- Diálogo ADS: tarjeta con radio 22, título y texto en Sora, botón principal
         naranja con texto navy y secundario de texto (DEF-22). Lo usa
         MaterialAlertDialogBuilder en toda la app. -->
    <style name="ThemeOverlay.ADS.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.ADS</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.ADS.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.ADS.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ADS.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ADS.Button.Dialog.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.ADS.Button.Dialog.Text</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <!-- Sin el tinte naranja que Material 3 suma por la elevación: fondo de tarjeta ADS -->
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <!-- Diálogo a pantalla completa con el tema ADS (cancelar servicio) -->
    <style name="Theme.ADS.FullScreenDialog" parent="Theme.ADSv">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/ads_surface</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <!-- Lo usa PendingRequestsActivity en el manifest; es el mismo tema ADS -->
    <style name="AppTheme" parent="Theme.ADSv" />

    <!-- Toolbar de las pantallas aún no rediseñadas -->

    <!-- Campo del login/registro actual: ahora es el campo ADS -->
</resources>
