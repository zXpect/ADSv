<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fondo claro con tinte del color primario -->
    <solid android:color="#E3F2FD"/>

    <!-- Esquinas redondeadas para badge -->
    <corners android:radius="20dp"/>

    <!-- Borde opcional para definir mejor el badge -->
    <stroke
        android:width="1dp"
        android:color="@color/colorPrimary"/>

    <!-- Padding interno -->
    <padding
        android:left="10dp"
        android:top="6dp"
        android:right="10dp"
        android:bottom="6dp"/>

</shape>