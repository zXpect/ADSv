        android:fillColor="#FFFFFFFF"
        android:pathData="M52.5,66 H67.5 V104.5 A7.5,7.5 0,0 1,52.5 104.5 Z M60,95.4 L56.02,97.7 L56.02,102.3 L60,104.6 L63.98,102.3 L63.98,97.7 Z" />
