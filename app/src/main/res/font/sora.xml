<?xml version="1.0" encoding="utf-8"?>
<!-- Sora (Google Fonts, licencia OFL). Familia por defecto del tema.
     textStyle="bold" usa la 600; para la 800 usar @font/sora_extrabold. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/sora_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/sora_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/sora_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/sora_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
</font-family>
