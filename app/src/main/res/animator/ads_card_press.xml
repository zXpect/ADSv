<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta que se hunde un poco al tocarla (relieve) y vuelve al soltarla -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="90" android:propertyName="scaleX" android:valueTo="0.97" android:valueType="floatType" />
            <objectAnimator android:duration="90" android:propertyName="scaleY" android:valueTo="0.97" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="160" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="160" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
