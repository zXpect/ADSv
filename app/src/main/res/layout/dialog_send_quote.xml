<?xml version="1.0" encoding="utf-8"?>
<!-- Cotizar · mockup 16 (docs/mockups/Cotizar.dc.html). Pantalla completa desde
     QuoteDialogHelper: precio, motivo del ajuste si sale del rango y agenda. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_6">

            <ImageButton
                android:id="@+id/btn_quote_back"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/bg_ads_circle_button"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ads_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:accessibilityHeading="true"
                android:fontFamily="@font/sora_extrabold"
                android:text="@string/quote_screen_title"
                android:textAppearance="@style/TextAppearance.ADS.Title" />

            <!-- Estimado de ADS y tareas -->
            <TextView
                android:id="@+id/tv_quote_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.ADS.Caption"
                tools:text="Estimado de ADS: $55.500 – $110.000" />

            <TextView
                android:id="@+id/tv_quote_reference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/bg_ads_notice"
                android:padding="@dimen/space_3"
                android:textAppearance="@style/TextAppearance.ADS.Caption"
                android:textColor="@color/ads_charcoal"
                tools:text="• Reparar cortocircuito · 1 visita" />

            <!-- Precio -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:labelFor="@id/et_quote_price"
                android:text="@string/quote_screen_price_label"
                android:textAppearance="@style/TextAppearance.ADS.Label"
                android:textColor="@color/ads_charcoal" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_quote_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:hintEnabled="false"
                app:prefixText="$ ">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_quote_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora_extrabold"
                    android:hint="@string/quote_screen_price_hint"
                    android:inputType="number"
                    android:maxLength="9"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_quote_limits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:fontFamily="@font/sora"
                android:textAppearance="@style/TextAppearance.ADS.Label"
                android:visibility="gone"
                tools:text="La tarifa mínima por visita es $25.500"
                tools:visibility="visible" />

            <!-- Motivo del ajuste (cuando el precio sale del estimado) -->
            <LinearLayout
                android:id="@+id/layout_adjustment_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tv_adjustment_reason_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quote_card_reason_label"
                    android:textAppearance="@style/TextAppearance.ADS.Label"
                    android:textColor="@color/ads_charcoal" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_adjustment_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    app:chipSpacingHorizontal="@dimen/space_2"
                    app:singleSelection="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:fontFamily="@font/sora"
                    android:text="@string/quote_screen_other_hint"
                    android:textAppearance="@style/TextAppearance.ADS.Label" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_adjustment_reason_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:visibility="gone"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_adjustment_reason_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/cancel_reason_text_hint"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="300"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Fecha, hora y duración -->
            <include
                android:id="@+id/schedule_fields"
                layout="@layout/view_schedule_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra de acción fija -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ads_bar"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_line"
            android:background="@color/ads_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/screen_margin">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quote_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quote_dialog_send" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:fontFamily="@font/sora"
                android:gravity="center"
                android:text="@string/quote_screen_note"
                android:textAppearance="@style/TextAppearance.ADS.Label" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
