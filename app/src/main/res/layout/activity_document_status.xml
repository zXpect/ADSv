<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.ads.activities.worker.DocumentStatusActivity">

    <!-- Main Content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- AppBar -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            app:elevation="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/colorPrimary"
                android:theme="@style/ToolBarTheme"
                app:titleTextColor="@color/whitevariable"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:layout_scrollFlags="scroll|enterAlways" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="@color/whitevariable"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:paddingBottom="90dp">

                <!-- Header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Documentos de Verificación"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:gravity="center"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gestiona tus documentos y revisa su estado de verificación"
                    android:textSize="14sp"
                    android:textColor="@color/secondary_text"
                    android:gravity="center"
                    android:layout_marginBottom="30dp"/>

                <!-- Card de Estado General -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardVerificationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/card_background">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/ivStatusIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_info"
                                app:tint="@color/primary_color" />

                            <TextView
                                android:id="@+id/tvVerificationStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Estado de verificación"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary_text"
                                android:layout_marginStart="10dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvVerificationMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tus documentos están siendo verificados"
                            android:textSize="14sp"
                            android:textColor="@color/secondary_text"
                            android:layout_marginTop="8dp"
                            android:layout_marginStart="34dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Progress Bar de Subida -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardUploadProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/card_background">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ProgressBar
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="10dp"
                                android:indeterminateTint="@color/primary_color" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Subiendo documento..."
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary_text" />

                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/uploadProgressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="@color/primary_color"
                            android:progressBackgroundTint="#E0E0E0"
                            android:layout_marginBottom="5dp" />

                        <TextView
                            android:id="@+id/tvUploadProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0 de 0 documento(s) subido(s)"
                            android:textSize="12sp"
                            android:textColor="@color/secondary_text"
                            android:gravity="end" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Progress bar de carga inicial -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp" />

                <!-- Estado vacío -->
                <LinearLayout
                    android:id="@+id/layoutEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="40dp"
                    android:layout_marginTop="20dp">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/ic_document"
                        android:alpha="0.3"
                        app:tint="@color/primary_color"
                        android:layout_marginBottom="20dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No tienes documentos"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aún no has subido ningún documento para verificación. Agrega tus documentos para comenzar el proceso."
                        android:textSize="14sp"
                        android:textColor="@color/secondary_text"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <!-- Título de Mis Documentos -->
                <TextView
                    android:id="@+id/tvDocumentsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mis Documentos"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_marginBottom="15dp"
                    android:visibility="gone"/>

                <!-- RecyclerView para TODOS los documentos -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerDocuments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    tools:listitem="@layout/item_document" />

                <!-- Info adicional -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Los documentos deben estar en formato PDF. Serán revisados por nuestro equipo en un plazo de 24-48 horas. Si un documento es rechazado, podrás actualizarlo desde la lista."
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:gravity="center"
                    android:layout_marginTop="20dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_info_box"/>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- FAB flotante con menú emergente -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddDocument"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:src="@drawable/ic_add"
            android:contentDescription="Agregar documento"
            app:tint="@color/whitevariable"
            app:backgroundTint="@color/colorPrimary"
            app:elevation="8dp"
            app:hoveredFocusedTranslationZ="12dp"
            app:pressedTranslationZ="16dp"
            app:borderWidth="0dp"
            app:fabSize="normal" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="@color/whitevariable"
        app:itemTextColor="@color/text_primary"
        app:itemIconTint="@color/text_secondary"
        app:itemBackground="@color/nav_item_background"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>