<?xml version="1.0" encoding="utf-8"?>
<!-- Mis documentos del trabajador (estilo del mockup 33): estado de la revisión,
     lista de documentos y barra fija para agregar uno. Conserva los IDs que usa
     DocumentStatusActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.worker.DocumentStatusActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_6">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/bg_ads_circle_button"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ads_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityHeading="true"
                android:text="@string/account_my_documents"
                android:textAppearance="@style/TextAppearance.ADS.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/mydocs_subtitle"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                android:textColor="@color/ads_muted" />

            <!-- Estado de la revisión -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVerificationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:contentPadding="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ads_verify_circle">

                        <ImageView
                            android:id="@+id/ivStatusIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ads_verify_pending" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvVerificationStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong"
                            tools:text="Verificación en proceso" />

                        <TextView
                            android:id="@+id/tvVerificationMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.ADS.Caption"
                            tools:text="Tienes 2 documentos en revisión." />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Subida en curso -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUploadProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:contentPadding="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mydocs_uploading"
                        android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong" />

                    <ProgressBar
                        android:id="@+id/uploadProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:max="100"
                        android:progressTint="@color/ads_brand" />

                    <TextView
                        android:id="@+id/tvUploadProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:textAppearance="@style/TextAppearance.ADS.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:indeterminateTint="@color/ads_brand"
                android:visibility="gone" />

            <!-- Sin documentos -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_document"
                    app:tint="@color/ads_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/mydocs_empty_title"
                    android:textAppearance="@style/TextAppearance.ADS.Subtitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:gravity="center"
                    android:text="@string/mydocs_empty_message"
                    android:textAppearance="@style/TextAppearance.ADS.Caption" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDocumentsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:accessibilityHeading="true"
                android:text="@string/mydocs_list_title"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDocuments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/mydocs_rules"
                android:textAppearance="@style/TextAppearance.ADS.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra de acción fija -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ads_bar"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_line"
            android:background="@color/ads_line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fabAddDocument"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_marginBottom="@dimen/space_6"
            android:text="@string/mydocs_add" />
    </LinearLayout>
</LinearLayout>
