<?xml version="1.0" encoding="utf-8"?>
<!-- Re-cotización (cliente) · mockup 22 (docs/mockups/ReCotizacionCliente.dc.html) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.client.RequoteAnswerActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_ads_circle_button"
                    android:contentDescription="@string/action_back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/ads_text" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_requote_answer_status"
                    style="@style/Widget.ADS.StatusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/ads_navy"
                    android:textColor="@color/ads_on_navy"
                    tools:text="En progreso" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_requote_answer_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.ADS.Headline"
                tools:text="Carlos propone un nuevo precio" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/requote_answer_once"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall" />

            <!-- Precio actual y nuevo -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ADS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/requote_answer_current"
                            android:textAppearance="@style/TextAppearance.ADS.Label" />

                        <TextView
                            android:id="@+id/tv_requote_answer_current"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:textAppearance="@style/TextAppearance.ADS.Price"
                            android:textColor="@color/ads_muted"
                            android:textSize="20sp"
                            tools:text="$95.000" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/requote_answer_new"
                            android:textAppearance="@style/TextAppearance.ADS.Label"
                            android:textColor="@color/ads_brand_text" />

                        <TextView
                            android:id="@+id/tv_requote_answer_new"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:textAppearance="@style/TextAppearance.ADS.Price"
                            android:textSize="24sp"
                            tools:text="$130.000" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Motivo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/bg_ads_notice"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/requote_reason_label"
                    android:textAppearance="@style/TextAppearance.ADS.Label" />

                <TextView
                    android:id="@+id/tv_requote_answer_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong"
                    tools:text="Dificultad del trabajo" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_requote_answer_reject_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.ADS.Caption"
                tools:text="Si rechazas, se mantiene el precio original de $95.000." />
        </LinearLayout>
    </ScrollView>

    <!-- Barra de acción fija -->
    <LinearLayout
        android:id="@id/ads_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ads_bar"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_line"
            android:background="@color/ads_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/screen_margin">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_requote_accept"
                style="@style/Widget.ADS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/requote_answer_accept" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_requote_reject"
                style="@style/Widget.ADS.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/requote_answer_reject" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
