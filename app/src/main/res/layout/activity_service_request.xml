<?xml version="1.0" encoding="utf-8"?>
<!-- Solicitud, paso 1 de 2: elegir las tareas · mockup 10 (docs/mockups/Solicitud.dc.html).
     Las tareas del oficio se agregan desde ServiceRequestActivity (item_request_task_option). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.client.ServiceRequestActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_6">

            <!-- Volver y técnico elegido -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_request_back"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_ads_circle_button"
                    android:contentDescription="@string/action_back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/ads_text" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:background="@drawable/bg_ads_pill_outline"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_1"
                    android:paddingTop="@dimen/space_1"
                    android:paddingEnd="14dp"
                    android:paddingBottom="@dimen/space_1">

                    <TextView
                        android:id="@+id/tv_worker_initials"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_ads_avatar"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.ADS.Label"
                        android:textColor="@color/ads_surface"
                        android:textSize="11sp"
                        tools:text="CR" />

                    <TextView
                        android:id="@+id/worker_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong"
                        android:textSize="13sp"
                        tools:text="Carlos Rojas" />
                </LinearLayout>
            </LinearLayout>

            <!-- Paso 1 de 2 -->
            <include
                layout="@layout/view_request_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4" />

            <TextView
                android:id="@+id/tv_request_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/sora"
                android:text="@string/request_step1_label"
                android:textAppearance="@style/TextAppearance.ADS.Label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityHeading="true"
                android:fontFamily="@font/sora_extrabold"
                android:text="@string/request_step1_title"
                android:textAppearance="@style/TextAppearance.ADS.Title" />

            <!-- Oficio (se puede cambiar si el técnico tiene varios) -->
            <TextView
                android:id="@+id/tv_service_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_min"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong"
                android:textColor="@color/ads_brand_text"
                tools:text="Electricidad" />

            <TextView
                android:id="@+id/tv_no_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                android:visibility="gone"
                tools:text="Este trabajador aún no tiene un oficio del catálogo" />

            <LinearLayout
                android:id="@+id/layout_task_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra de acción fija -->
    <LinearLayout
        android:id="@id/ads_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ads_bar"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_line"
            android:background="@color/ads_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/screen_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_selected_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.ADS.Caption"
                    tools:text="2 tareas seleccionadas" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora_semibold"
                    android:text="@string/request_price_at_end"
                    android:textAppearance="@style/TextAppearance.ADS.Caption"
                    android:textColor="@color/ads_text" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send_request"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/request_continue" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
