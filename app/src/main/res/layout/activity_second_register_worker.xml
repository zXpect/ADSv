<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/whitevariable"
    tools:context="com.ads.activities.worker.SecondRegisterWorkerActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Documentos de Verificación"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sube los documentos requeridos para verificar tu perfil"
            android:textSize="14sp"
            android:textColor="@color/secondary_text"
            android:gravity="center"
            android:layout_marginBottom="30dp"/>

        <!-- Documentos Obligatorios -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Documentos Obligatorios"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:layout_marginBottom="15dp"/>

        <!-- Hoja de Vida -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutHojaVida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_document"
                        app:tint="@color/primary_color"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hoja de Vida (CV)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_marginStart="10dp"/>

                    <ImageView
                        android:id="@+id/ivHojaVidaCheck"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="gone"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHojaVidaStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No seleccionado"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="34dp"/>

                <Button
                    android:id="@+id/btnSelectHojaVida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar PDF"
                    android:textAllCaps="false"
                    android:layout_marginTop="10dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Antecedentes Judiciales -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutAntecedentes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_document"
                        app:tint="@color/primary_color"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Antecedentes Judiciales"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_marginStart="10dp"/>

                    <ImageView
                        android:id="@+id/ivAntecedentesCheck"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="gone"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAntecedentesStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No seleccionado"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="34dp"/>

                <Button
                    android:id="@+id/btnSelectAntecedentes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar PDF"
                    android:textAllCaps="false"
                    android:layout_marginTop="10dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Sección de Certificaciones (Obligatorio) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Certificaciones (Obligatorio)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona el tipo de certificación que deseas subir"
            android:textSize="14sp"
            android:textColor="@color/secondary_text"
            android:layout_marginBottom="15dp"/>

        <!-- Radio Group para seleccionar tipo -->
        <RadioGroup
            android:id="@+id/rgCertificationType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/rbCartas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cartas de Recomendación"
                android:textColor="@color/primary_text"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rbTitulos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Títulos/Certificados"
                android:textColor="@color/primary_text"/>
        </RadioGroup>

        <!-- Sección de Cartas de Recomendación -->
        <LinearLayout
            android:id="@+id/layoutCartasSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cartas de Recomendación (Mínimo 3)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:layout_marginBottom="15dp"/>

            <!-- Carta 1 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutCarta1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_document"
                            app:tint="@color/primary_color"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Carta de Recomendación 1"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_text"
                            android:layout_marginStart="10dp"/>

                        <ImageView
                            android:id="@+id/ivCarta1Check"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check_circle"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCarta1Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No seleccionado"
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="34dp"/>

                    <Button
                        android:id="@+id/btnSelectCarta1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Seleccionar PDF"
                        android:textAllCaps="false"
                        android:layout_marginTop="10dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Carta 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutCarta2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_document"
                            app:tint="@color/primary_color"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Carta de Recomendación 2"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_text"
                            android:layout_marginStart="10dp"/>

                        <ImageView
                            android:id="@+id/ivCarta2Check"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check_circle"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCarta2Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No seleccionado"
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="34dp"/>

                    <Button
                        android:id="@+id/btnSelectCarta2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Seleccionar PDF"
                        android:textAllCaps="false"
                        android:layout_marginTop="10dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Carta 3 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutCarta3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_document"
                            app:tint="@color/primary_color"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Carta de Recomendación 3"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_text"
                            android:layout_marginStart="10dp"/>

                        <ImageView
                            android:id="@+id/ivCarta3Check"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check_circle"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCarta3Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No seleccionado"
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="34dp"/>

                    <Button
                        android:id="@+id/btnSelectCarta3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Seleccionar PDF"
                        android:textAllCaps="false"
                        android:layout_marginTop="10dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Sección de Títulos/Certificados -->
        <LinearLayout
            android:id="@+id/layoutTitulosSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Títulos o Certificados (Mínimo 1)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:layout_marginBottom="15dp"/>

            <!-- Título 1 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutTitulo1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_document"
                            app:tint="@color/primary_color"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Título/Certificado 1"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_text"
                            android:layout_marginStart="10dp"/>

                        <ImageView
                            android:id="@+id/ivTitulo1Check"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check_circle"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTitulo1Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No seleccionado"
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="34dp"/>

                    <Button
                        android:id="@+id/btnSelectTitulo1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Seleccionar PDF"
                        android:textAllCaps="false"
                        android:layout_marginTop="10dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Título 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutTitulo2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_document"
                            app:tint="@color/primary_color"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Título/Certificado 2 (Opcional)"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_text"
                            android:layout_marginStart="10dp"/>

                        <ImageView
                            android:id="@+id/ivTitulo2Check"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check_circle"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTitulo2Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No seleccionado"
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="34dp"/>

                    <Button
                        android:id="@+id/btnSelectTitulo2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Seleccionar PDF"
                        android:textAllCaps="false"
                        android:layout_marginTop="10dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Título 3 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutTitulo3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_document"
                            app:tint="@color/primary_color"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Título/Certificado 3 (Opcional)"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_text"
                            android:layout_marginStart="10dp"/>

                        <ImageView
                            android:id="@+id/ivTitulo3Check"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check_circle"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTitulo3Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No seleccionado"
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="34dp"/>

                    <Button
                        android:id="@+id/btnSelectTitulo3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Seleccionar PDF"
                        android:textAllCaps="false"
                        android:layout_marginTop="10dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Progress Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 de 0 documentos subidos"
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:gravity="center"
                android:layout_marginTop="5dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Botones de Acción -->
        <Button
            android:id="@+id/btnSubmitDocuments"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Subir Documentos"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:enabled="false"
            android:backgroundTint="@color/primary_color"
            android:textColor="@android:color/white"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnSkip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Omitir por ahora"
            android:textAllCaps="false"
            android:textColor="@color/secondary_text"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

        <!-- Info adicional -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Los documentos deben estar en formato PDF. Si eliges cartas de recomendación, debes subir mínimo 3. Si eliges títulos/certificados, debes subir mínimo 1. Serán revisados por nuestro equipo en un plazo de 24-48 horas."
            android:textSize="12sp"
            android:textColor="@color/secondary_text"
            android:gravity="center"
            android:layout_marginTop="15dp"
            android:padding="10dp"
            android:background="@drawable/bg_info_box"/>
    </LinearLayout>
</ScrollView>