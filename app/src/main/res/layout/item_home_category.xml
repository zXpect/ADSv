<?xml version="1.0" encoding="utf-8"?>
<!-- Oficio en la cuadrícula del inicio · mockup 06 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_home_category"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:contentPadding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_home_category"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_ads_icon_tile"
            android:contentDescription="@null"
            android:padding="6dp"
            android:scaleType="fitCenter"
            tools:src="@drawable/icon_electrician" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_home_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.ADS.Subtitle"
            app:autoSizeMaxTextSize="15sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeTextType="uniform"
            tools:text="Electricidad" />
        <!-- Autoajuste: con letra grande «Electricidad» se achica en vez de cortarse -->
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
