<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Main Content -->
        <LinearLayout
            android:id="@+id/layout_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Header con degradado sutil -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimary"
                android:elevation="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="20dp"
                android:paddingHorizontal="20dp">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_button_circle_white"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Volver"
                    android:padding="10dp"
                    app:tint="@color/colorPrimary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout
                    android:id="@+id/header_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintTop_toTopOf="@id/btn_back"
                    app:layout_constraintBottom_toBottomOf="@id/btn_back"
                    app:layout_constraintStart_toEndOf="@id/btn_back"
                    app:layout_constraintEnd_toStartOf="@id/iv_status_icon">

                    <TextView
                        android:id="@+id/tv_request_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Solicitud #12345"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/textOnlywhite"
                        android:letterSpacing="0.01" />

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="En Progreso"
                        android:textSize="14sp"
                        android:textColor="@color/textOnlywhite"
                        android:alpha="0.90" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_status_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_work_active"
                    android:padding="8dp"
                    android:background="@drawable/circle_white_background"
                    app:tint="@color/colorPrimary"
                    app:layout_constraintTop_toTopOf="@id/btn_back"
                    app:layout_constraintBottom_toBottomOf="@id/btn_back"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Hace 30 minutos"
                    android:textSize="13sp"
                    android:textColor="@color/textOnlywhite"
                    android:alpha="0.75"
                    android:drawableStart="@drawable/ic_time_small"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/textOnlywhite"
                    app:layout_constraintTop_toBottomOf="@id/header_info"
                    app:layout_constraintStart_toStartOf="@id/header_info" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Status Flow con mejor diseño -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:background="@color/card_background"
                android:elevation="4dp">

                <LinearLayout
                    android:id="@+id/layout_status_flow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="24dp">

                    <!-- Accepted -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:minWidth="85dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">

                            <View
                                android:id="@+id/status_accepted"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_status_active" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check"
                                app:tint="@color/textOnlywhite" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Aceptado"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorPrimary"
                            android:gravity="center" />

                    </LinearLayout>

                    <View
                        android:id="@+id/line_accepted_to_way"
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="-30dp"
                        android:background="@color/colorPrimary" />

                    <!-- On the Way -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:minWidth="85dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">

                            <View
                                android:id="@+id/status_on_the_way"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_status_inactive" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_directions"
                                app:tint="@color/text_secondary" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="En Camino"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center" />

                    </LinearLayout>

                    <View
                        android:id="@+id/line_way_to_progress"
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="-30dp"
                        android:background="@color/divider_color" />

                    <!-- In Progress -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:minWidth="85dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">

                            <View
                                android:id="@+id/status_in_progress"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_status_inactive" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_work"
                                app:tint="@color/text_secondary" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Trabajando"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center" />

                    </LinearLayout>

                    <View
                        android:id="@+id/line_progress_to_completed"
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="-30dp"
                        android:background="@color/divider_color" />

                    <!-- Completed -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:minWidth="85dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">

                            <View
                                android:id="@+id/status_completed"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_status_inactive" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/text_secondary" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Completado"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Service Information Card con mejor estructura -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Información del Servicio"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="20dp"
                        android:drawableStart="@drawable/ic_document"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/colorPrimary" />

                    <!-- Service Type -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:background="@drawable/bg_info_item"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_light">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_work"
                                app:tint="@color/colorPrimary" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tipo de Servicio"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:alpha="0.8" />

                            <TextView
                                android:id="@+id/tv_service_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Electricidad"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Client Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:background="@drawable/bg_info_item"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_light">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_person"
                                app:tint="@color/colorPrimary" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cliente"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:alpha="0.8" />

                            <TextView
                                android:id="@+id/tv_client_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Juan Pérez"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Phone -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:background="@drawable/bg_info_item"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_light">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_phone"
                                app:tint="@color/colorPrimary" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Teléfono"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:alpha="0.8" />

                            <TextView
                                android:id="@+id/tv_client_phone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="+57 300 123 4567"
                                android:textSize="16sp"
                                android:textColor="@color/colorPrimary"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Address -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:background="@drawable/bg_info_item"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_light">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_location"
                                app:tint="@color/colorPrimary" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dirección"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:alpha="0.8" />

                            <TextView
                                android:id="@+id/tv_address"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Calle 123 #45-67, Neiva"
                                android:textSize="16sp"
                                android:textColor="@color/text_primary" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Description -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:background="@drawable/bg_info_item"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_light">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_document"
                                app:tint="@color/colorPrimary" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Descripción"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:alpha="0.8" />

                            <TextView
                                android:id="@+id/tv_description"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Reparación de instalación eléctrica"
                                android:textSize="16sp"
                                android:textColor="@color/text_primary" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Quick Actions con mejor diseño -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_call_client"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Llamar"
                    android:textColor="@color/textOnlywhite"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_phone"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/textOnlywhite"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/colorPrimary"
                    app:elevation="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_map"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Ver Mapa"
                    android:textColor="@color/colorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_location"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/colorPrimary"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/colorPrimary"
                    app:strokeWidth="2dp"
                    app:backgroundTint="@color/card_background"
                    app:elevation="4dp" />

            </LinearLayout>

            <!-- Action Buttons Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Start Trip Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_trip"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Iniciar Viaje"
                        android:textColor="@color/textOnlywhite"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_directions"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="@color/textOnlywhite"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/colorPrimary"
                        android:visibility="gone" />

                    <!-- Start Work Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_work"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Iniciar Trabajo"
                        android:textColor="@color/textOnlywhite"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_work"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="@color/textOnlywhite"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/colorAccent"
                        android:visibility="gone" />

                    <!-- Finish Work Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_finish_work"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Finalizar Trabajo"
                        android:textColor="@color/textOnlywhite"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_check_circle"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="@color/textOnlywhite"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/success_color"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/colorPrimary"
            android:visibility="gone" />

        <!-- Error Message Container -->
        <LinearLayout
            android:id="@+id/error_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_error"
                android:alpha="0.5"
                app:tint="@color/error_color" />

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Error al cargar los datos"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/error_color"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Por favor, intenta nuevamente"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:gravity="center" />

        </LinearLayout>

    </FrameLayout>

</ScrollView>