<?xml version="1.0" encoding="utf-8"?>
<!-- Servicio del trabajador · mockups 23 (aceptada), 48 (en camino) y 49 (en progreso):
     docs/mockups/ServicioCurso.dc.html, ServicioEnCamino.dc.html y ServicioEnProgreso.dc.html.
     Se conservan los IDs que usa ServiceDetailWorkerActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.worker.ServiceDetailWorkerActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_4"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_6">

                <!-- Volver y estado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_back"
                        android:layout_width="@dimen/touch_min"
                        android:layout_height="@dimen/touch_min"
                        android:background="@drawable/bg_ads_circle_button"
                        android:contentDescription="@string/action_back"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/ads_text" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_status"
                        style="@style/Widget.ADS.StatusChip.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="En camino" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/service_worker_for"
                        android:textAppearance="@style/TextAppearance.ADS.Caption" />

                    <TextView
                        android:id="@+id/tv_client_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.ADS.Headline"
                        tools:text="Cliente" />

                    <!-- Bloque navy: precio, agenda y dirección -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:background="@drawable/bg_ads_status_card"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_5"
                        android:paddingTop="18dp"
                        android:paddingEnd="@dimen/space_5"
                        android:paddingBottom="18dp">

                        <LinearLayout
                            android:id="@+id/layout_quote_price"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:baselineAligned="true"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_quote_price_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/service_worker_agreed_price"
                                android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                                android:textColor="@color/ads_on_navy_muted" />

                            <TextView
                                android:id="@+id/tv_quote_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/sora_extrabold"
                                android:textColor="@color/ads_on_navy"
                                android:textSize="26sp"
                                tools:text="$95.000" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_timestamp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/space_2"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                            android:textColor="@color/ads_on_navy"
                            app:drawableStartCompat="@drawable/ic_clock"
                            app:drawableTint="@color/ads_brand"
                            tools:text="Hoy · 3:00 p. m. · 2 h" />

                        <TextView
                            android:id="@+id/tv_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:drawablePadding="@dimen/space_2"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                            android:textColor="@color/ads_on_navy"
                            app:drawableStartCompat="@drawable/ic_location_small"
                            app:drawableTint="@color/ads_brand"
                            tools:text="Cra 5 # 4-20, Ubaté" />
                    </LinearLayout>

                    <!-- Llamar y cómo llegar (funciones existentes): una línea a 360 dp con letra normal;
                         con letra grande se parten en dos líneas en vez de cortarse -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_call_client"
                            style="@style/Widget.ADS.Button.Text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/service_worker_call"
                            app:icon="@drawable/ic_phone"
                            android:paddingStart="@dimen/space_2"
                            android:paddingEnd="@dimen/space_2"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_view_map"
                            style="@style/Widget.ADS.Button.Text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/service_worker_directions"
                            app:icon="@drawable/ic_map"
                            android:paddingStart="@dimen/space_2"
                            android:paddingEnd="@dimen/space_2"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="18dp" />
                    </LinearLayout>

                    <!-- Tareas, cotización y pago -->
                    <LinearLayout
                        android:id="@+id/card_quote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_quote_details_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/worker_detail_tasks"
                            android:textAppearance="@style/TextAppearance.ADS.Label"
                            android:textColor="@color/ads_muted" />

                        <TextView
                            android:id="@+id/tv_quote_details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                            tools:text="Reparar cortocircuito (1 visita)" />

                        <TextView
                            android:id="@+id/tv_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                            android:textColor="@color/ads_muted"
                            tools:text="La luz de la cocina se apaga sola." />

                        <!-- Método de pago elegido por el cliente (mockup 23, D10) -->
                        <TextView
                            android:id="@+id/tv_payment_method"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:textAppearance="@style/TextAppearance.ADS.Label"
                            android:fontFamily="@font/sora_regular"
                            android:visibility="gone"
                            tools:text="Pago: efectivo" />

                        <TextView
                            android:id="@+id/tv_quote_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong"
                            tools:text="Precio acordado con el cliente." />

                        <TextView
                            android:id="@+id/tv_payment_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_quote_primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:text="@string/quote_send"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_quote_reschedule"
                            style="@style/Widget.ADS.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="@string/service_worker_reschedule"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Pasos: Viaje · Trabajo · Finalizar -->
                    <LinearLayout
                        android:id="@+id/layout_status_flow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <View
                                android:id="@+id/status_on_the_way"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:background="@drawable/bg_ads_progress_off" />

                            <TextView
                                android:id="@+id/tv_step_trip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/service_worker_step_trip"
                                android:textAppearance="@style/TextAppearance.ADS.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <View
                                android:id="@+id/status_in_progress"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:background="@drawable/bg_ads_progress_off" />

                            <TextView
                                android:id="@+id/tv_step_work"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/service_worker_step_work"
                                android:textAppearance="@style/TextAppearance.ADS.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <View
                                android:id="@+id/status_completed"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:background="@drawable/bg_ads_progress_off" />

                            <TextView
                                android:id="@+id/tv_step_finish"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/service_worker_step_finish"
                                android:textAppearance="@style/TextAppearance.ADS.Caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_step_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textAppearance="@style/TextAppearance.ADS.Caption"
                        tools:text="Ya no puedes cancelar. Si hay un problema, crea una PQR." />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.ADS.Body"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/ads_brand"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Barra de acción fija -->
    <LinearLayout
        android:id="@+id/card_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ads_bar"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_line"
            android:background="@color/ads_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_6">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_trip"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/service_worker_start_trip"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_work"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/service_worker_start_work"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_finish_work"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/service_worker_finish"
                android:visibility="gone" />

            <!-- Completado y en efectivo: registrar el pago (mockup 31, D10) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_register_cash"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/cash_register_action"
                android:visibility="gone" />

            <!-- En camino o en progreso: re-cotizar una vez (mockups 24 y 49, D7) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_requote"
                style="@style/Widget.ADS.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/requote_action"
                android:visibility="gone" />

            <!-- En camino o en progreso: el problema se tramita como PQR, como el cliente (MEJ-01) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_pqr"
                style="@style/Widget.ADS.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/pqr_create"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quote_cancel"
                style="@style/Widget.ADS.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/service_worker_cancel"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
