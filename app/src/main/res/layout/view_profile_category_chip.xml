<?xml version="1.0" encoding="utf-8"?>
<!-- Oficio del técnico en su perfil (mockup 09): ficha con borde naranja, no táctil -->
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checkable="false"
    android:clickable="false"
    android:focusable="false"
    android:textAppearance="@style/TextAppearance.ADS.Chip"
    android:textColor="@color/ads_pin_brand"
    app:chipBackgroundColor="@android:color/transparent"
    app:chipSurfaceColor="@android:color/transparent"
    app:chipCornerRadius="@dimen/radius_sm"
    app:chipMinHeight="34dp"
    app:chipStrokeColor="@color/ads_pin_brand"
    app:chipStrokeWidth="1.5dp"
    app:ensureMinTouchTargetSize="false" />
