<?xml version="1.0" encoding="utf-8"?>
<!-- Solicitud en la bandeja · mockup 14: cliente y hace cuánto, oficio,
     dirección y precio (rango de referencia o cotizado). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_pending_request"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClientName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                android:textSize="16sp"
                tools:text="Laura Gómez" />

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:fontFamily="@font/sora"
                android:textAppearance="@style/TextAppearance.ADS.Label"
                tools:text="Hace 5 min" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvServiceType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.ADS.BodySmall"
            android:textColor="@color/ads_charcoal"
            tools:text="Electricidad" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="6dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.ADS.Caption"
                app:drawableStartCompat="@drawable/ic_location_small"
                app:drawableTint="@color/ads_muted"
                tools:text="Cra 5 # 4-20" />

            <TextView
                android:id="@+id/tvEstimatedCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.ADS.Price"
                android:textSize="14sp"
                tools:text="$55.500 – $110.000" />
        </LinearLayout>

        <!-- Del diseño anterior; el mockup no los muestra -->
        <TextView
            android:id="@+id/tvRequestId"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvUrgencyLevel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
