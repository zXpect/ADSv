<?xml version="1.0" encoding="utf-8"?>
<!-- Elegir rol · mockup 03 (docs/mockups/Rol.dc.html) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:fillViewport="true"
    tools:context="com.project.ads.activities.RoleActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/bg_ads_circle_button"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ads_text" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ads_logo" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_role_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:accessibilityHeading="true"
            android:text="@string/role_title"
            android:textAppearance="@style/TextAppearance.ADS.Headline"
            android:textSize="28sp"
            app:lineHeight="36sp" />

        <TextView
            android:id="@+id/tv_role_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/role_subtitle_register"
            android:textAppearance="@style/TextAppearance.ADS.BodySmall"
            android:textColor="@color/ads_muted" />

        <!-- Soy cliente -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_role_client"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="22dp"
            app:contentPadding="@dimen/space_5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_ads_icon_tile_navy">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_home"
                        app:tint="@color/ads_brand" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_client"
                        android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="@string/role_client_desc"
                        android:textAppearance="@style/TextAppearance.ADS.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/space_2"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ads_chevron"
                    app:tint="@color/ads_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Soy trabajador -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_role_worker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="22dp"
            app:contentPadding="@dimen/space_5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_ads_icon_tile_brand">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_jobs"
                        app:tint="@color/ads_navy" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_worker"
                        android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="@string/role_worker_desc"
                        android:textAppearance="@style/TextAppearance.ADS.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/space_2"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ads_chevron"
                    app:tint="@color/ads_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_6" />

        <!-- ¿Ya tienes cuenta? Inicia sesión / ¿No tienes cuenta? Crea una -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_role_switch_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/role_have_account"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall" />

            <TextView
                android:id="@+id/btn_role_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/sora_extrabold"
                android:minHeight="@dimen/touch_min"
                android:gravity="center_vertical"
                android:text="@string/role_login"
                android:textColor="@color/ads_brand_text"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
