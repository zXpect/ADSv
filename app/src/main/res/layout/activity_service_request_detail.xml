<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle y seguimiento de la solicitud del cliente · mockups 17, 20, 45, 46 y 55
     (RevisarCotizacion, Seguimiento, SeguimientoEnCamino, SeguimientoEnProgreso,
     SeguimientoCompletada). El contenido cambia según el estado desde
     ServiceRequestDetailActivity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    tools:context="com.project.ads.activities.client.ServiceRequestDetailActivity">

    <LinearLayout
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_4"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_6">

                <!-- Volver y estado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_back"
                        android:layout_width="@dimen/touch_min"
                        android:layout_height="@dimen/touch_min"
                        android:background="@drawable/bg_ads_circle_button"
                        android:contentDescription="@string/action_back"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/ads_text" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_status"
                        style="@style/Widget.ADS.StatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        tools:text="Aceptada" />
                </LinearLayout>

                <!-- Título según el estado -->
                <TextView
                    android:id="@+id/tv_detail_eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:textAppearance="@style/TextAppearance.ADS.Caption"
                    android:visibility="gone"
                    tools:text="Cotización de"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.ADS.Headline"
                    tools:text="Tu servicio" />

                <TextView
                    android:id="@+id/tv_service_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                    tools:text="Electricidad · Lun 19 oct, 3:00 p. m." />

                <!-- Técnico -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_worker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    app:contentPaddingBottom="14dp"
                    app:contentPaddingTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_worker_initials"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_ads_avatar"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                            android:textColor="@color/ads_surface"
                            android:textSize="16sp"
                            tools:text="CR" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_worker_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                                tools:text="Carlos Rojas" />

                            <TextView
                                android:id="@+id/tv_worker_phone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.ADS.Caption"
                                tools:text="310 555 0000" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btn_call_worker"
                            android:layout_width="@dimen/touch_min"
                            android:layout_height="@dimen/touch_min"
                            android:background="@drawable/bg_ads_stepper_button"
                            android:contentDescription="@string/detail_call_worker"
                            android:padding="11dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/ads_brand_text" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Línea de tiempo: Aceptada → En camino → En progreso → Completada -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layout_status_flow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:contentPaddingBottom="18dp"
                    app:contentPaddingTop="18dp">

                    <LinearLayout
                        android:id="@+id/layout_timeline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Cotización y pago (mockup 17) -->
                <include
                    layout="@layout/layout_quote_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="@dimen/space_3"
                    android:layout_marginEnd="0dp" />

                <!-- Dónde y detalles -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sora"
                            android:text="@string/detail_address"
                            android:textAppearance="@style/TextAppearance.ADS.Label" />

                        <TextView
                            android:id="@+id/tv_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong"
                            tools:text="Cra 5 # 4-20, Ubaté" />

                        <TextView
                            android:id="@+id/tv_description_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:fontFamily="@font/sora"
                            android:text="@string/detail_description"
                            android:textAppearance="@style/TextAppearance.ADS.Label" />

                        <TextView
                            android:id="@+id/tv_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                            android:textColor="@color/ads_charcoal"
                            tools:text="El tablero está en el patio" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Barra de acción fija -->
        <LinearLayout
            android:id="@+id/card_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ads_bar"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_line"
                android:background="@color/ads_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="14dp"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/screen_margin">

                <TextView
                    android:id="@+id/tv_actions_note_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_2"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.ADS.Caption"
                    android:textColor="@color/ads_charcoal"
                    android:visibility="gone"
                    tools:text="Ya no puedes cancelar desde aquí. Si hay un problema, crea una PQR."
                    tools:visibility="visible" />

                <!-- Cotización por responder (mockup 17) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_detail_accept_quote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_accept_quote"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_detail_reject_quote"
                    style="@style/Widget.ADS.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/quote_reject"
                    android:visibility="gone" />

                <!-- Completada: pagar o calificar (mockup 55) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pay_service"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:text="Pagar $95.000" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rate_service"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:text="Calificar servicio" />

                <!-- Cancelar con motivo antes de «Iniciar viaje» (mockups 20 y 21) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel_request"
                    style="@style/Widget.ADS.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/detail_cancel_service"
                    android:visibility="gone" />

                <!-- En camino o en progreso: el problema se tramita como PQR (mockups 45 y 46) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_detail_create_pqr"
                    style="@style/Widget.ADS.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pqr_create"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_actions_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:fontFamily="@font/sora"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.ADS.Label"
                    android:visibility="gone"
                    tools:text="Puedes cancelar hasta que el técnico salga. Después, usa una PQR."
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/ads_brand" />

    <!-- Error -->
    <LinearLayout
        android:id="@+id/error_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.ADS.Subtitle"
            tools:text="Solicitud no encontrada" />
    </LinearLayout>
</FrameLayout>
