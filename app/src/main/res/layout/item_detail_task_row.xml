<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de tarea en el detalle del trabajador (mockup 15): nombre y cantidad -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/field_height"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tv_detail_task_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong"
        tools:text="Reparar cortocircuito" />

    <TextView
        android:id="@+id/tv_detail_task_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.ADS.Caption"
        tools:text="1 visita" />
</LinearLayout>
