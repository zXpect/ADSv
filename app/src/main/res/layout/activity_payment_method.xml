<?xml version="1.0" encoding="utf-8"?>
<!-- Método de pago · mockup 18 (docs/mockups/Pago.dc.html). Se abre al aceptar la
     cotización y desde «Cambiar método» del seguimiento (mockup 20). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.client.PaymentMethodActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_6">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/bg_ads_circle_button"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ads_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:accessibilityHeading="true"
                android:text="@string/payment_method_title"
                android:textAppearance="@style/TextAppearance.ADS.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/payment_method_subtitle"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall" />

            <!-- Pago en línea -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_method_digital"
                style="@style/Widget.ADS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/radius_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/icon_tile_lg"
                        android:layout_height="@dimen/icon_tile_lg"
                        android:background="@drawable/bg_ads_icon_tile_payment"
                        android:backgroundTint="@color/ads_navy">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_notif_payment"
                            app:tint="@color/ads_brand" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/payment_method_digital"
                                android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                                android:textSize="16sp" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radio_method_digital"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                app:buttonTint="@color/ads_radio_tint" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_method_digital_detail"
                            android:textAppearance="@style/TextAppearance.ADS.Caption" />

                        <TextView
                            style="@style/Widget.ADS.StatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="@string/payment_method_sandbox" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Efectivo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_method_cash"
                style="@style/Widget.ADS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/radius_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/icon_tile_lg"
                        android:layout_height="@dimen/icon_tile_lg"
                        android:background="@drawable/bg_ads_icon_tile_payment"
                        android:backgroundTint="@color/ads_brand">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_payment_cash"
                            app:tint="@color/ads_navy" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/payment_method_cash"
                                android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                                android:textSize="16sp" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radio_method_cash"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                app:buttonTint="@color/ads_radio_tint" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_method_cash_detail"
                            android:textAppearance="@style/TextAppearance.ADS.Caption" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Barra de acción fija: total y confirmar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ads_bar"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_line"
            android:background="@color/ads_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/screen_margin">

            <LinearLayout
                android:id="@+id/layout_payment_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/payment_method_total"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall" />

                <TextView
                    android:id="@+id/tv_payment_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.ADS.Price"
                    android:textSize="22sp"
                    tools:text="$95.000" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_payment_method_confirm"
                style="@style/Widget.ADS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/payment_method_confirm_accept" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
