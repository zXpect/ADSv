<?xml version="1.0" encoding="utf-8"?>
<!-- Método de pago · esquema nuevo (docs/rediseno-v2): cabecera de marca, opciones como
     filas de selección con íconos del mismo color. Se abre al aceptar la cotización y
     desde «Cambiar método» del seguimiento. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.client.PaymentMethodActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_6">

            <LinearLayout
                android:id="@+id/payment_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_5"
                android:background="@drawable/bg_ads_brand_header"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_4"
                android:paddingTop="@dimen/space_2"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_6">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/ads_on_brand_header" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_marginTop="@dimen/space_2"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/sora_extrabold"
                    android:text="@string/payment_method_title"
                    android:textColor="@color/ads_on_brand_header"
                    android:textSize="27sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/payment_method_subtitle"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                    android:textColor="@color/ads_on_brand_header" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin">

            <!-- Pago en línea -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_method_digital"
                style="@style/Widget.ADS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/radius_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_notif_payment"
                        app:tint="@color/ads_chip_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_method_digital"
                            android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_method_digital_detail"
                            android:textAppearance="@style/TextAppearance.ADS.Caption" />

                        <TextView
                            style="@style/Widget.ADS.StatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="@string/payment_method_sandbox" />
                    </LinearLayout>

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_method_digital"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:buttonTint="@color/ads_radio_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Efectivo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_method_cash"
                style="@style/Widget.ADS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/radius_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_payment_cash"
                        app:tint="@color/ads_chip_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_method_cash"
                            android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_method_cash_detail"
                            android:textAppearance="@style/TextAppearance.ADS.Caption" />
                    </LinearLayout>

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_method_cash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:buttonTint="@color/ads_radio_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Barra de acción fija: total y confirmar -->
    <LinearLayout
        android:id="@id/ads_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ads_bar"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_line"
            android:background="@color/ads_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/screen_margin">

            <LinearLayout
                android:id="@+id/layout_payment_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/payment_method_total"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall" />

                <TextView
                    android:id="@+id/tv_payment_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.ADS.Price"
                    android:textSize="22sp"
                    tools:text="$95.000" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_payment_method_confirm"
                style="@style/Widget.ADS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/payment_method_confirm_accept" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
