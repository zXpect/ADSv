<?xml version="1.0" encoding="utf-8"?>
<!-- Mapa del trabajador · mockups 57 (conectado) y 58 (desconectado):
     docs/mockups/MapaTrabajador.dc.html y MapaTrabajadorOff.dc.html -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.worker.MapWorkerActivity">

    <!-- Volver, título e interruptor Conectado / Desconectado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_5"
        android:paddingEnd="@dimen/screen_margin">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_ads_circle_button"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ads_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/map_worker_title"
                android:textAppearance="@style/TextAppearance.ADS.Headline" />

            <TextView
                android:id="@+id/tv_map_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/map_worker_subtitle_off"
                android:textAppearance="@style/TextAppearance.ADS.Caption" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_connection_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ads_pill_off"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_min"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="14dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_connection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:minHeight="0dp"
                android:scaleX="0.8"
                android:scaleY="0.8"
                app:thumbTint="@color/ads_switch_thumb"
                app:trackDecorationTint="@android:color/transparent"
                app:trackTint="@color/ads_switch_track" />

            <TextView
                android:id="@+id/tv_connection_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_worker_disconnected"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong" />
        </LinearLayout>
    </LinearLayout>

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1" />

    <!-- Hoja inferior: solicitud cercana o aviso del estado -->
    <LinearLayout
        android:id="@+id/sheet_map_worker"
        android:layout_width="match_parent"
        android:animateLayoutChanges="true"
        android:layout_height="wrap_content"
        android:layout_marginTop="-24dp"
        android:background="@drawable/bg_ads_bottom_sheet"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="18dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/group_sheet_request"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_ads_icon_tile">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_jobs"
                    app:tint="@color/ads_chip_text" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sheet_request_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong"
                    tools:text="Cliente · Plomería" />

                <TextView
                    android:id="@+id/tv_sheet_request_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.ADS.Caption"
                    tools:text="A 1,2 km de ti" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/map_worker_off_title"
            android:textAppearance="@style/TextAppearance.ADS.Subtitle" />

        <TextView
            android:id="@+id/tv_sheet_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/map_worker_off_message"
            android:textAppearance="@style/TextAppearance.ADS.BodySmall"
            android:textColor="@color/ads_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnconnect"
            style="@style/Widget.ADS.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/map_worker_connect" />
    </LinearLayout>
</LinearLayout>
