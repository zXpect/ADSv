<?xml version="1.0" encoding="utf-8"?>
<!-- Esqueleto del inicio del trabajador mientras llega su primer dato de Firebase
     (HomeWorkerActivity.hideHomeSkeleton): cabecera de marca fija, hoja del estado y
     contadores. Evita mostrar un estado («Perfil incompleto») antes de saber el real.
     El fondo y la cabecera nunca laten: solo los bloques (home_skeleton_blocks). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_skeleton"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:importantForAccessibility="noHideDescendants">

    <View
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bg_ads_brand_header" />

    <LinearLayout
        android:id="@+id/home_skeleton_blocks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin">

        <View
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:background="@drawable/bg_ads_sheet_card" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/space_6"
                android:layout_weight="1"
                android:background="@drawable/bg_ads_skeleton_block" />

            <View
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ads_skeleton_block" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/space_5"
            android:background="@drawable/bg_ads_skeleton_block" />
    </LinearLayout>
</FrameLayout>
