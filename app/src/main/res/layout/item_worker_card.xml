<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/worker_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Worker Image -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp">

            <ImageView
                android:id="@+id/worker_image"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/logo"
                android:contentDescription="Foto del trabajador"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background" />

            <!-- Worker Type Icon -->
            <ImageView
                android:id="@+id/worker_type_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/icon_worker"
                android:background="@drawable/circle_white_background"
                android:padding="4dp"
                android:contentDescription="Tipo de servicio" />

        </FrameLayout>

        <!-- Worker Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Name and Rating Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/worker_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nombre Trabajador"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/worker_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 4.5"
                    android:textSize="14sp"
                    android:textColor="@color/rating_color"
                    android:background="@drawable/rating_background"
                    android:padding="4dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Work Type -->
            <TextView
                android:id="@+id/worker_work"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de trabajo"
                android:textSize="14sp"
                android:textColor="@color/colorPrimary"
                android:layout_marginTop="4dp"
                android:drawableLeft="@drawable/ic_work_small"
                android:drawablePadding="4dp"
                android:gravity="center_vertical" />

            <!-- Distance and Status Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/worker_distance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1.2 km"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray"
                    android:drawableLeft="@drawable/ic_location_small"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/circle_green"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disponible"
                    android:textSize="12sp"
                    android:textColor="@color/status_available" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action Button -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="Ver detalles"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

</androidx.cardview.widget.CardView>