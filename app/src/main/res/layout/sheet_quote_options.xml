<?xml version="1.0" encoding="utf-8"?>
<!-- Opciones de una cotización por responder: rechazarla o cancelar el servicio.
     La abre «Rechazar o cancelar» en ServiceRequestDetailActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_5"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:fontFamily="@font/sora_extrabold"
        android:text="@string/quote_options_title"
        android:textColor="@color/ads_text"
        android:textSize="20sp" />

    <LinearLayout
        android:id="@+id/row_quote_reject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quote_options_reject"
                android:textAppearance="@style/TextAppearance.ADS.Subtitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quote_options_reject_detail"
                android:textAppearance="@style/TextAppearance.ADS.Caption" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_3"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/ads_muted" />
    </LinearLayout>

    <View
        android:id="@+id/divider_quote_options"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_line"
        android:background="@color/ads_line" />

    <LinearLayout
        android:id="@+id/row_quote_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detail_cancel_service"
                android:textAppearance="@style/TextAppearance.ADS.Subtitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quote_options_cancel_detail"
                android:textAppearance="@style/TextAppearance.ADS.Caption" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_3"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/ads_muted" />
    </LinearLayout>
</LinearLayout>
