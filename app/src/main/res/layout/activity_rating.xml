<?xml version="1.0" encoding="utf-8"?>
<!-- Calificar servicio · mockup 30 (docs/mockups/Calificar.dc.html). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.client.RatingActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin">

            <ImageButton
                android:id="@+id/btn_rating_close"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/bg_ads_circle_button"
                android:contentDescription="@string/rating_close"
                android:src="@drawable/ic_close"
                app:tint="@color/ads_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="420dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_rating_initials"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_ads_avatar"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                    android:textColor="@color/ads_surface"
                    android:textSize="30sp"
                    tools:text="CR" />

                <TextView
                    android:id="@+id/tv_worker_name_rating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/sora_extrabold"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.ADS.Title"
                    tools:text="¿Cómo te fue con Carlos?" />

                <TextView
                    android:id="@+id/tv_service_type_rating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:gravity="center"
                    android:text="@string/rating_subtitle"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall" />

                <!-- Estrellas de 1 a 5 (lo que acepta el backend) -->
                <LinearLayout
                    android:id="@+id/layout_rating_stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_star_1"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/rating_star_1"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_star_filled" />

                    <ImageButton
                        android:id="@+id/btn_star_2"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="@dimen/space_1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/rating_star_2"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_star_filled" />

                    <ImageButton
                        android:id="@+id/btn_star_3"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="@dimen/space_1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/rating_star_3"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_star_filled" />

                    <ImageButton
                        android:id="@+id/btn_star_4"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="@dimen/space_1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/rating_star_4"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_star_filled" />

                    <ImageButton
                        android:id="@+id/btn_star_5"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="@dimen/space_1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/rating_star_5"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_star_filled" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_rating_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:minHeight="22dp"
                    android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                    android:textColor="@color/ads_brand_text"
                    tools:text="Muy bueno" />

                <!-- Comentario opcional (se envía con la calificación) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_rating_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_5"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_rating_comment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/rating_comment_hint"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="500"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tv_already_rated_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="32dp">

        <ProgressBar
            android:id="@+id/rating_progress_bar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/space_2"
            android:indeterminateTint="@color/ads_brand"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_rating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rating_submit" />
    </LinearLayout>
</LinearLayout>
