<?xml version="1.0" encoding="utf-8"?>
<!-- Solicitud enviada · mockup 12 (docs/mockups/SolicitudEnviada.dc.html). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="32dp"
    tools:context="com.project.ads.activities.client.RequestSentActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_request_sent_icon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_ads_avatar"
            android:contentDescription="@null"
            android:padding="28dp"
            android:src="@drawable/ic_ads_check"
            app:tint="@color/ads_brand" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="@string/request_sent_title"
            android:textAppearance="@style/TextAppearance.ADS.Headline" />

        <TextView
            android:id="@+id/tv_request_sent_message"
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.ADS.BodySmall"
            tools:text="Carlos Rojas la revisará y te enviará una cotización con el precio, la fecha y la hora de llegada." />

        <!-- Estado de la solicitud -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:contentDescription="@string/request_sent_status_desc"
            app:contentPaddingBottom="18dp"
            app:contentPaddingTop="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_request_sent_step1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_ads_check_on"
                        android:contentDescription="@null"
                        android:padding="4dp"
                        android:src="@drawable/ic_ads_check" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/request_status_pending"
                        android:textAppearance="@style/TextAppearance.ADS.Label"
                        android:textColor="@color/ads_text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_ads_check_off" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:fontFamily="@font/sora"
                        android:text="@string/request_status_quoted"
                        android:textAppearance="@style/TextAppearance.ADS.Label" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_ads_check_off" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:fontFamily="@font/sora"
                        android:text="@string/request_status_accepted"
                        android:textAppearance="@style/TextAppearance.ADS.Label" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_view_request"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/request_sent_view" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back_home"
        style="@style/Widget.ADS.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:text="@string/request_sent_home" />
</LinearLayout>
