<?xml version="1.0" encoding="utf-8"?>
<!-- Motivo de cancelación (mockups 21 y 50): radio y texto; borde naranja al elegirlo -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="56dp"
    app:cardCornerRadius="@dimen/radius_md"
    app:checkedIcon="@null"
    app:contentPaddingBottom="@dimen/space_3"
    app:contentPaddingTop="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/view_cancel_radio"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_ads_check_off" />

        <TextView
            android:id="@+id/tv_cancel_reason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong"
            tools:text="Ya no lo necesito" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
