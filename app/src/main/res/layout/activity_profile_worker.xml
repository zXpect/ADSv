<?xml version="1.0" encoding="utf-8"?>
<!-- Mi cuenta del trabajador · mockup 51 (docs/mockups/MiCuentaTrab.dc.html).
     Se conservan los IDs que usa ProfileWorkerActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.worker.ProfileWorkerActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_5"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_6">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/nav_account"
                    android:textAppearance="@style/TextAppearance.ADS.Headline" />

                <!-- Foto o iniciales, nombre y verificación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp">

                        <TextView
                            android:id="@+id/tv_profile_worker_initials"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_ads_avatar"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                            android:textColor="@color/ads_surface"
                            android:textSize="22sp"
                            tools:text="CR" />

                        <ImageView
                            android:id="@+id/ivProfileImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/profile_photo_desc"
                            android:scaleType="centerCrop" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvWorkerName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                            android:textSize="18sp"
                            tools:text="Carlos Rojas" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardVerificationBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            app:cardBackgroundColor="@color/ads_chip_bg"
                            app:cardCornerRadius="@dimen/radius_chip"
                            app:contentPaddingBottom="3dp"
                            app:contentPaddingLeft="10dp"
                            app:contentPaddingRight="10dp"
                            app:contentPaddingTop="3dp"
                            app:strokeWidth="0dp">

                            <TextView
                                android:id="@+id/tvVerificationBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.ADS.Label"
                                android:textColor="@color/ads_chip_text"
                                tools:text="Verificado" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvWorkerType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:textAppearance="@style/TextAppearance.ADS.Caption"
                            tools:text="Electricidad" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Opciones -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_5"
                    app:contentPadding="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/bg_ads_row_divider"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <LinearLayout
                            android:id="@+id/btnEditProfile"
                            style="@style/Widget.ADS.AccountRow">

                            <ImageView
                                style="@style/Widget.ADS.AccountRow.Icon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_nav_account" />

                            <TextView
                                style="@style/Widget.ADS.AccountRow.Text"
                                android:text="@string/account_my_data" />

                            <ImageView
                                style="@style/Widget.ADS.AccountRow.Chevron"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnDocuments"
                            style="@style/Widget.ADS.AccountRow">

                            <ImageView
                                style="@style/Widget.ADS.AccountRow.Icon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_nav_requests" />

                            <TextView
                                style="@style/Widget.ADS.AccountRow.Text"
                                android:text="@string/account_my_documents" />

                            <ImageView
                                style="@style/Widget.ADS.AccountRow.Chevron"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/row_account_notifications"
                            style="@style/Widget.ADS.AccountRow">

                            <ImageView
                                style="@style/Widget.ADS.AccountRow.Icon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ads_bell" />

                            <TextView
                                style="@style/Widget.ADS.AccountRow.Text"
                                android:text="@string/account_notifications" />

                            <ImageView
                                style="@style/Widget.ADS.AccountRow.Chevron"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <!-- Solo visible con las notificaciones apagadas (NotificationPermissionHelper) -->
                        <LinearLayout
                            android:id="@+id/row_account_enable_notifications"
                            style="@style/Widget.ADS.AccountRow"
                            android:visibility="gone">

                            <ImageView
                                style="@style/Widget.ADS.AccountRow.Icon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ads_bell" />

                            <TextView
                                style="@style/Widget.ADS.AccountRow.Text"
                                android:text="@string/account_enable_notifications" />

                            <ImageView
                                style="@style/Widget.ADS.AccountRow.Chevron"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/row_account_pqr"
                            style="@style/Widget.ADS.AccountRow">

                            <ImageView
                                style="@style/Widget.ADS.AccountRow.Icon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_nav_pqr" />

                            <TextView
                                style="@style/Widget.ADS.AccountRow.Text"
                                android:text="@string/nav_pqr" />

                            <ImageView
                                style="@style/Widget.ADS.AccountRow.Chevron"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/row_account_terms"
                            style="@style/Widget.ADS.AccountRow">

                            <ImageView
                                style="@style/Widget.ADS.AccountRow.Icon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_info" />

                            <TextView
                                style="@style/Widget.ADS.AccountRow.Text"
                                android:text="@string/account_terms" />

                            <ImageView
                                style="@style/Widget.ADS.AccountRow.Chevron"
                                android:contentDescription="@null" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.ADS.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/profile_logout" />

                <!-- Del diseño anterior; el mockup no los muestra -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvWorkerEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvWorkerPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvTotalServices"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvPricePerHour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvMemberSince"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:id="@+id/btnBankInfo"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:id="@+id/btnChangePassword"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/ads_brand"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/view_bottom_nav_worker" />
</LinearLayout>
