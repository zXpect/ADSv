<?xml version="1.0" encoding="utf-8"?>
<!-- Re-cotizar (trabajador) · mockup 24 (docs/mockups/ReCotizar.dc.html) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.worker.RequoteActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_6">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/bg_ads_circle_button"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ads_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:accessibilityHeading="true"
                android:text="@string/requote_title"
                android:textAppearance="@style/TextAppearance.ADS.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/requote_subtitle"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall" />

            <!-- Una sola vez (D7) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/bg_ads_notice"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_4"
                android:paddingTop="@dimen/space_3"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="@dimen/space_3"
                android:text="@string/requote_once"
                android:textAppearance="@style/TextAppearance.ADS.Caption"
                android:textColor="@color/ads_charcoal"
                app:drawableStartCompat="@drawable/ic_notif_quote"
                app:drawableTint="@color/ads_brand_text" />

            <TextView
                android:id="@+id/tv_requote_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                tools:text="Precio actual: $95.000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:labelFor="@id/et_requote_price"
                android:text="@string/requote_price_label"
                android:textAppearance="@style/TextAppearance.ADS.Label"
                android:textColor="@color/ads_charcoal" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_requote_price"
                style="@style/Widget.ADS.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:hintEnabled="false"
                app:prefixText="$ ">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_requote_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="9" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_requote_reason_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/requote_reason_label"
                android:textAppearance="@style/TextAppearance.ADS.Label"
                android:textColor="@color/ads_charcoal" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_requote_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                app:singleSelection="true" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_requote_reason_text"
                style="@style/Widget.ADS.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:visibility="gone"
                app:counterEnabled="true"
                app:counterMaxLength="300"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_requote_reason_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/requote_reason_text_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="300" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Barra de acción fija -->
    <LinearLayout
        android:id="@id/ads_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ads_bar"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_line"
            android:background="@color/ads_line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_requote_send"
            style="@style/Widget.ADS.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_marginBottom="@dimen/screen_margin"
            android:text="@string/requote_send" />
    </LinearLayout>
</LinearLayout>
