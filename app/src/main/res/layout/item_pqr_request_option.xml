<?xml version="1.0" encoding="utf-8"?>
<!-- Solicitud en el pop-up «Solicitud relacionada» de Crear PQR: ícono del oficio,
     estado, fecha y precio. La elegida lleva borde naranja y un visto. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_4"
    android:paddingTop="@dimen/space_1"
    android:paddingEnd="@dimen/space_4"
    android:paddingBottom="@dimen/space_1">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_pqr_request"
        style="@style/Widget.ADS.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stateListAnimator="@null"
        app:cardElevation="0dp"
        app:contentPadding="@dimen/space_3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_request_icon"
                android:layout_width="@dimen/icon_tile"
                android:layout_height="@dimen/icon_tile"
                android:background="@drawable/bg_ads_category_circle"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:tint="@color/ads_category_icon"
                tools:src="@drawable/icon_electrician" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_pqr_request_service"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong"
                        tools:text="Electricidad" />

                    <TextView
                        android:id="@+id/tv_pqr_request_status"
                        style="@style/Widget.ADS.StatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        tools:text="Completada" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_pqr_request_detail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.ADS.Caption"
                        tools:text="17 oct, 2:06 p. m. · $50.000" />

                    <ImageView
                        android:id="@+id/iv_pqr_request_selected"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:contentDescription="@string/pqr_request_selected"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="gone"
                        app:tint="@color/ads_brand_text" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
