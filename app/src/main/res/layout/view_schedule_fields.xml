<?xml version="1.0" encoding="utf-8"?>
<!-- Fecha, hora de llegada y duración estimada (D9); se usa al cotizar y al reprogramar.
     Estilo de campos ADS (mockup 16). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/schedule_arrival_label"
            android:textAppearance="@style/TextAppearance.ADS.Label"
            android:textColor="@color/ads_charcoal" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_schedule_date"
            style="@style/Widget.ADS.Button.Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/schedule_pick_date" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_schedule_time"
            style="@style/Widget.ADS.Button.Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/schedule_pick_time" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:text="@string/schedule_duration_label"
        android:textAppearance="@style/TextAppearance.ADS.Label"
        android:textColor="@color/ads_charcoal" />

    <Spinner
        android:id="@+id/sp_duration"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_ads_field"
        android:paddingStart="@dimen/space_2"
        android:paddingEnd="@dimen/space_2" />

    <TextView
        android:id="@+id/tv_schedule_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:textColor="@color/error_color"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
