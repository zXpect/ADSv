<?xml version="1.0" encoding="utf-8"?>
<!-- Solicitud, paso 2 de 2: dirección y precio · mockups 11 y 47
     (docs/mockups/SolicitudResumen.dc.html, SolicitudSinRango.dc.html). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.client.VerifyRequestActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_6">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/bg_ads_circle_button"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ads_text" />

            <include
                android:id="@+id/layout_request_steps"
                layout="@layout/view_request_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/sora"
                android:text="@string/request_step2_label"
                android:textAppearance="@style/TextAppearance.ADS.Label" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityHeading="true"
                android:fontFamily="@font/sora_extrabold"
                android:text="@string/request_step2_title"
                android:textAppearance="@style/TextAppearance.ADS.Title" />

            <!-- Dirección -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:labelFor="@id/et_address"
                android:text="@string/request_address_label"
                android:textAppearance="@style/TextAppearance.ADS.Label"
                android:textColor="@color/ads_charcoal" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/request_address_hint"
                    android:inputType="textPostalAddress|textCapSentences"
                    android:maxLength="200"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/btn_use_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="@dimen/space_2"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_min"
                android:text="@string/request_use_location"
                android:textAppearance="@style/TextAppearance.ADS.Caption"
                android:fontFamily="@font/sora_semibold"
                android:textColor="@color/ads_brand_text"
                app:drawableStartCompat="@drawable/ic_my_location"
                app:drawableTint="@color/ads_brand_text" />

            <!-- Detalles opcionales (se envían como descripción de la solicitud) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:labelFor="@id/et_description"
                android:text="@string/request_details_label"
                android:textAppearance="@style/TextAppearance.ADS.Label"
                android:textColor="@color/ads_charcoal" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/request_details_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="500"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Precio estimado -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/service_details_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_price_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/request_price_estimated"
                        android:textAppearance="@style/TextAppearance.ADS.Caption"
                        android:fontFamily="@font/sora_semibold" />

                    <LinearLayout
                        android:id="@+id/layout_price_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <ProgressBar
                        android:id="@+id/progress_estimate"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_3"
                        android:indeterminateTint="@color/ads_brand" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_line"
                        android:layout_marginTop="@dimen/space_3"
                        android:background="@color/ads_line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_total_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/request_total_estimated"
                            android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong" />

                        <TextView
                            android:id="@+id/tv_amount_content"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_3"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textAppearance="@style/TextAppearance.ADS.Price"
                            android:textSize="18sp"
                            tools:text="$55.500 – $110.000" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Aviso de precio -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ADS.Card.Notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info"
                        app:tint="@color/ads_charcoal" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_price_notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/request_price_notice"
                            android:textAppearance="@style/TextAppearance.ADS.Caption"
                            android:textColor="@color/ads_charcoal" />

                        <TextView
                            android:id="@+id/tv_min_fee_notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:fontFamily="@font/sora"
                            android:textAppearance="@style/TextAppearance.ADS.Label"
                            android:visibility="gone"
                            tools:text="La tarifa mínima por visita es $25.500. Es el piso del precio, no un cobro aparte."
                            tools:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra de acción fija -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ads_bar"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_line"
            android:background="@color/ads_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/screen_margin">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/request_send" />

            <TextView
                android:id="@+id/tv_send_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:fontFamily="@font/sora"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.ADS.Label"
                tools:text="Aún no pagas nada. Carlos te enviará una cotización." />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
