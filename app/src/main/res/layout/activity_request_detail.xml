<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle de solicitud del trabajador · mockup 15 (docs/mockups/SolicitudDetalle.dc.html).
     «Cotizar» abre la cotización (mockup 16). Se conservan los IDs de RequestDetailActivity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    tools:context="com.project.ads.activities.worker.RequestDetailActivity">

    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_4"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="@dimen/touch_min"
                        android:layout_height="@dimen/touch_min"
                        android:background="@drawable/bg_ads_circle_button"
                        android:contentDescription="@string/action_back"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/ads_text" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvStatus"
                        style="@style/Widget.ADS.StatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        tools:text="Pendiente" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/worker_detail_request_of"
                    android:textAppearance="@style/TextAppearance.ADS.Caption" />

                <TextView
                    android:id="@+id/tvClientName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.ADS.Headline"
                    tools:text="Laura Gómez" />

                <TextView
                    android:id="@+id/tvTimestamp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.ADS.Caption"
                    tools:text="Electricidad · hace 5 min" />

                <!-- Tareas -->
                <TextView
                    android:id="@+id/tv_detail_tasks_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_5"
                    android:accessibilityHeading="true"
                    android:text="@string/worker_detail_tasks"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_detail_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    app:cardCornerRadius="18dp"
                    app:contentPaddingBottom="@dimen/space_1"
                    app:contentPaddingTop="@dimen/space_1">

                    <LinearLayout
                        android:id="@+id/layout_detail_tasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/bg_ads_row_divider"
                        android:orientation="vertical"
                        android:showDividers="middle" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Servicio y descripción -->
                <TextView
                    android:id="@+id/tvServiceType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.ADS.Caption"
                    android:visibility="gone"
                    tools:text="Electricidad" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                    android:textColor="@color/ads_charcoal"
                    tools:text="El tablero está en el patio" />

                <!-- Dónde -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:accessibilityHeading="true"
                    android:text="@string/worker_detail_where"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    app:cardCornerRadius="18dp"
                    app:contentPaddingBottom="14dp"
                    app:contentPaddingTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_ads_icon_tile"
                            android:contentDescription="@null"
                            android:padding="10dp"
                            android:src="@drawable/ic_location"
                            app:tint="@color/ads_chip_text" />

                        <TextView
                            android:id="@+id/tvAddress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_3"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong"
                            tools:text="Cra 5 # 4-20, Ubaté" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Precio estimado -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:accessibilityHeading="true"
                    android:text="@string/request_price_estimated"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/bg_ads_price_block"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:id="@+id/tvEstimatedCost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_extrabold"
                        android:textColor="@color/ads_on_navy"
                        android:textSize="24sp"
                        tools:text="$55.500 – $110.000" />

                    <TextView
                        android:id="@+id/tv_detail_price_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/sora"
                        android:textAppearance="@style/TextAppearance.ADS.Label"
                        android:textColor="@color/ads_on_navy_muted"
                        tools:text="Puedes confirmar el estimado o ajustarlo con un motivo." />
                </LinearLayout>

                <!-- Contacto del cliente -->
                <TextView
                    android:id="@+id/tvClientPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="@dimen/space_2"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_min"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                    android:textColor="@color/ads_brand_text"
                    app:drawableStartCompat="@drawable/ic_phone"
                    app:drawableTint="@color/ads_brand_text"
                    tools:text="310 555 0000" />

                <TextView
                    android:id="@+id/tvClientEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_min"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                    android:textColor="@color/ads_brand_text"
                    tools:text="laura@correo.com" />

                <!-- Del diseño anterior; el mockup no los muestra -->
                <TextView
                    android:id="@+id/tvRequestId"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvUrgencyLevel"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Barra de acción fija -->
        <LinearLayout
            android:id="@+id/layout_detail_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ads_bar"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_line"
                android:background="@color/ads_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="14dp"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_4">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccept"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/worker_detail_quote" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReject"
                    style="@style/Widget.ADS.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/worker_detail_reject"
                    android:textColor="@color/ads_muted" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/ads_brand" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:textAppearance="@style/TextAppearance.ADS.Subtitle"
        android:visibility="gone" />
</FrameLayout>
