<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio de sesión · mockup 01 (docs/mockups/Main.dc.html).
     Cabecera navy con el logo y hoja crema con el formulario.
     Se conservan los IDs que usa LoginActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_start_bg"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context="com.project.ads.activities.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera navy: techo decorativo, logo y marca; la barra de volver va encima
             para que el formulario quepa sin desplazar en pantallas de 360 dp -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_ads_login_roof" />

            <!-- Logo y marca -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:paddingBottom="@dimen/space_6">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:contentDescription="@string/ads_logo_desc"
                    app:srcCompat="@drawable/ic_ads_logo_on_navy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:fontFamily="@font/sora_extrabold"
                    android:letterSpacing="0.25"
                    android:paddingStart="7dp"
                    android:text="@string/ads_wordmark"
                    android:textColor="@color/ads_on_navy"
                    android:textSize="28sp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Flecha de volver y rol elegido (lo pone MyToolbar) -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                app:contentInsetStart="8dp"
                app:titleTextAppearance="@style/TextAppearance.ADS.Subtitle"
                app:titleTextColor="@color/ads_on_navy" />
        </FrameLayout>

        <!-- Hoja con el formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ads_sheet_top"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="28dp"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_4">

            <TextView
                android:id="@+id/welcome_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textAppearance="@style/TextAppearance.ADS.Title" />

            <TextView
                android:id="@+id/welcome_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/login_subtitle"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall" />

            <!-- Correo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:labelFor="@id/editTextTextEmailAddress2"
                android:text="@string/email"
                android:textAppearance="@style/TextAppearance.ADS.Label"
                android:textColor="@color/ads_charcoal" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextTextEmailAddress2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:hint="@string/login_email_placeholder"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Contraseña -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:labelFor="@id/editTextTextPassword"
                android:text="@string/contraseña"
                android:textAppearance="@style/TextAppearance.ADS.Label"
                android:textColor="@color/ads_charcoal" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:endIconMode="password_toggle"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextTextPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:hint="@string/login_password_placeholder"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/touch_min"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_3"
                android:text="@string/login_forgot_password"
                android:textAppearance="@style/TextAppearance.ADS.Caption"
                android:fontFamily="@font/sora_semibold"
                android:textColor="@color/ads_brand_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/login_button" />

            <!-- Separador -->
            <LinearLayout
                android:id="@+id/separator_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stroke_line"
                    android:layout_weight="1"
                    android:background="@color/ads_line" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_marginEnd="@dimen/space_3"
                    android:text="@string/login_or_continue_with"
                    android:textAppearance="@style/TextAppearance.ADS.Caption"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stroke_line"
                    android:layout_weight="1"
                    android:background="@color/ads_line" />
            </LinearLayout>

            <!-- Google (Facebook y Twitter se quitaron: no tenían funcionalidad) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/social_login_container"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/space_4"
                app:cardCornerRadius="@dimen/radius_field"
                app:contentPadding="0dp">

                <FrameLayout
                    android:id="@+id/google_sign_in_button_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/google_color_vector" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/login_google"
                            android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong" />
                    </LinearLayout>

                    <com.google.android.gms.common.SignInButton
                        android:id="@+id/google_sign_in_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="invisible" />

                    <!-- Capa táctil: LoginActivity escucha este botón -->
                    <ImageButton
                        android:id="@+id/google_sign_in_image_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/google_login" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="@dimen/space_2" />

            <LinearLayout
                android:id="@+id/register_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_no_account"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                    android:textColor="@color/ads_charcoal" />

                <TextView
                    android:id="@+id/register_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_min"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/login_register"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                    android:fontFamily="@font/sora_extrabold"
                    android:textColor="@color/ads_brand_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
