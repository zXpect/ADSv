<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio del cliente · mockup 06 (docs/mockups/InicioCliente.dc.html).
     Saludo, buscador, tarjeta del mapa, oficios, servicio activo y barra inferior.
     La lista de técnicos vive ahora en WorkersActivity (mockup 08). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.client.HomeUserActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_5"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_6">

            <!-- Ubicación y saludo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_1"
                android:gravity="center_vertical"
                android:text="@string/home_location"
                android:textAppearance="@style/TextAppearance.ADS.Caption"
                app:drawableStartCompat="@drawable/ic_location_small"
                app:drawableTint="@color/ads_muted" />

            <TextView
                android:id="@+id/user_greeting_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:accessibilityHeading="true"
                android:fontFamily="@font/sora_extrabold"
                android:text="@string/home_greeting_default"
                android:textAppearance="@style/TextAppearance.ADS.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/home_question"
                android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                android:textSize="20sp" />

            <!-- Buscador -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_home_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:boxCornerRadiusBottomEnd="@dimen/radius_md"
                app:boxCornerRadiusBottomStart="@dimen/radius_md"
                app:boxCornerRadiusTopEnd="@dimen/radius_md"
                app:boxCornerRadiusTopStart="@dimen/radius_md"
                app:hintEnabled="false"
                app:startIconContentDescription="@null"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/home_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ver técnicos en el mapa -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/vermapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:clickable="true"
                android:focusable="true"
                app:contentPaddingBottom="14dp"
                app:contentPaddingTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/touch_min"
                        android:layout_height="@dimen/touch_min"
                        android:background="@drawable/bg_ads_icon_tile"
                        android:contentDescription="@null"
                        android:padding="11dp"
                        android:src="@drawable/ic_map"
                        app:tint="@color/ads_chip_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_map_title"
                            android:textAppearance="@style/TextAppearance.ADS.Subtitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_map_subtitle"
                            android:textAppearance="@style/TextAppearance.ADS.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/ads_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Oficios -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/home_categories_title"
                    android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora"
                    android:text="@string/home_categories_hint"
                    android:textAppearance="@style/TextAppearance.ADS.Label" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_home_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="-6dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="6"
                tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                tools:listitem="@layout/item_home_category"
                tools:spanCount="2" />

            <!-- Servicio activo -->
            <LinearLayout
                android:id="@+id/card_active_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:background="@drawable/bg_ads_active_service"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_4"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_ads_icon_tile_dark"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_nav_jobs"
                    app:tint="@color/ads_brand" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_active_service_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora"
                        android:textAppearance="@style/TextAppearance.ADS.Label"
                        android:textColor="@color/ads_on_navy_muted"
                        tools:text="Servicio activo · Plomería" />

                    <TextView
                        android:id="@+id/tv_active_service_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                        android:textColor="@color/ads_on_navy"
                        tools:text="El técnico va en camino" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/ads_on_navy" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_bottom_nav_client" />
</LinearLayout>
