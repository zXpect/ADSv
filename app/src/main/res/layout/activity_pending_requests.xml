<?xml version="1.0" encoding="utf-8"?>
<!-- Bandeja de solicitudes del trabajador · mockup 14 (docs/mockups/Bandeja.dc.html).
     Pestañas Nuevas / Cotizadas / Activas y barra inferior. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.worker.PendingRequestsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_5"
        android:paddingEnd="@dimen/screen_margin">

        <!-- Es una pestaña de la barra inferior: sin flecha de volver -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_ads_circle_button"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back"
            android:visibility="gone"
            app:tint="@color/ads_text" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/inbox_title"
            android:textAppearance="@style/TextAppearance.ADS.Headline" />
    </LinearLayout>

    <!-- Nuevas · Cotizadas · Activas -->
    <HorizontalScrollView
        android:id="@+id/layout_list_header"
        android:background="@color/ads_surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_inbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/space_2"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_inbox_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/inbox_tab_new" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_inbox_quoted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inbox_tab_quoted" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_inbox_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inbox_tab_active" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_3"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewRequests"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_1"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_6"
                tools:listitem="@layout/item_pending_request" />

            <!-- Tarjetas de relleno mientras carga la lista (antes, rueda de carga) -->
            <com.project.ads.includes.AdsSkeletonView
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_1"
                android:paddingEnd="@dimen/screen_margin"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_inbox"
                    app:tint="@color/ads_muted" />

                <TextView
                    android:id="@+id/tv_inbox_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center"
                    android:text="@string/inbox_empty_new"
                    android:textAppearance="@style/TextAppearance.ADS.Subtitle" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Aviso (pestaña Nuevas) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_inbox_notice"
        style="@style/Widget.ADS.Card.Notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_4"
        app:contentPaddingBottom="@dimen/space_3"
        app:contentPaddingTop="@dimen/space_3">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/inbox_notice"
            android:textAppearance="@style/TextAppearance.ADS.Caption"
            android:textColor="@color/ads_charcoal" />
    </com.google.android.material.card.MaterialCardView>

    <include layout="@layout/view_bottom_nav_worker" />
</LinearLayout>
