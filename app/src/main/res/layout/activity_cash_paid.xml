<?xml version="1.0" encoding="utf-8"?>
<!-- Pago en efectivo registrado (cliente) · mockup 29 (docs/mockups/PagoEfectivo.dc.html) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="32dp"
    tools:context="com.project.ads.activities.client.CashPaidActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_6"
            android:paddingBottom="@dimen/space_4">

            <FrameLayout
                android:id="@+id/frame_cash_paid_icon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_ads_icon_circle">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_payment_cash"
                    app:tint="@color/ads_navy" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:text="@string/cash_paid_title"
                android:textAppearance="@style/TextAppearance.ADS.Headline" />

            <TextView
                android:id="@+id/tv_cash_paid_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textAppearance="@style/TextAppearance.ADS.Amount"
                android:textSize="32sp"
                tools:text="$95.000" />

            <TextView
                android:id="@+id/tv_cash_paid_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:maxWidth="290dp"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                tools:text="El técnico registró que recibió el pago en efectivo." />

            <!-- Desacuerdo: PQR (D10) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_ads_notice"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_4"
                android:paddingTop="14dp"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="@dimen/space_1">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cash_paid_disagree"
                    android:textAppearance="@style/TextAppearance.ADS.Caption"
                    android:textColor="@color/ads_charcoal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cash_paid_pqr"
                    style="@style/Widget.ADS.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:text="@string/cash_paid_open_pqr"
                    app:icon="@drawable/ic_nav_pqr"
                    app:iconTint="@color/ads_brand_text" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cash_paid_rate"
        style="@style/Widget.ADS.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/detail_rate" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cash_paid_home"
        style="@style/Widget.ADS.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:text="@string/cash_paid_home" />
</LinearLayout>
