<?xml version="1.0" encoding="utf-8"?>
<!-- Barra inferior del client: 76 dp, fondo de barra y borde superior fino.
     Uso: <include layout="@layout/view_bottom_nav_client" /> al final de la pantalla
     y marcar el ítem activo con setSelectedItemId(R.id.nav_client_...). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_nav_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_line"
        android:background="@color/ads_line" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        app:menu="@menu/bottom_nav_client" />
</LinearLayout>
