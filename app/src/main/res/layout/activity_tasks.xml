<?xml version="1.0" encoding="utf-8"?>
<!-- Problemas del oficio · mockup 07 (docs/mockups/Tareas.dc.html). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_4"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_6"
    tools:context="com.project.ads.activities.client.TasksActivity">

    <ImageButton
        android:id="@+id/btn_tasks_back"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:background="@drawable/bg_ads_circle_button"
        android:contentDescription="@string/action_back"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/ads_text" />

    <!-- Oficio -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_tasks_category"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_ads_icon_tile"
            android:contentDescription="@null"
            android:padding="10dp"
            android:scaleType="fitCenter"
            tools:src="@drawable/icon_electrician" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tasks_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.ADS.Headline"
                tools:text="Electricidad" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tasks_question"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_tasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            tools:listitem="@layout/item_task" />

        <ProgressBar
            android:id="@+id/progress_tasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/ads_brand"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:gravity="center"
        android:text="@string/tasks_next_step"
        android:textAppearance="@style/TextAppearance.ADS.Caption" />
</LinearLayout>
