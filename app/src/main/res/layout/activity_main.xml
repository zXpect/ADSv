<?xml version="1.0" encoding="utf-8"?>
<!-- Bienvenida · mockup 02 (docs/mockups/Bienvenida.dc.html) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_header"
    tools:context="com.project.ads.activities.MainActivity">

    <!-- Techos de fondo (decorativos) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:src="@drawable/bg_ads_welcome_roofs" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageViewLogo"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:contentDescription="@string/welcome_logo_desc"
                android:src="@drawable/ic_ads_logo_on_navy" />

            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:importantForAccessibility="no"
                android:paddingStart="10dp"
                android:text="@string/welcome_wordmark"
                android:textAppearance="@style/TextAppearance.ADS.Wordmark"
                android:textColor="@color/ads_on_navy"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/textViewSubtitle"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:gravity="center"
                android:text="@string/welcome_tagline"
                android:textAppearance="@style/TextAppearance.ADS.Body"
                android:textColor="@color/ads_on_navy_muted" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLoginClient"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/welcome_create_account" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLoginWorker"
            style="@style/Widget.ADS.Button.OnNavy"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="@string/welcome_have_account" />
    </LinearLayout>
</FrameLayout>
