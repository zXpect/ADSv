<?xml version="1.0" encoding="utf-8"?>
<!-- Bienvenida · esquema nuevo (docs/rediseno-v2): bloque azul noche con el logo y la
     frase a la izquierda; las acciones van abajo sobre el fondo de la app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/ads_start_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_6"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_6">

        <ImageView
            android:id="@+id/imageViewLogo"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:contentDescription="@string/welcome_logo_desc"
            android:src="@drawable/ic_ads_logo_on_navy" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/textViewSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:fontFamily="@font/sora_extrabold"
            android:lineSpacingMultiplier="1.05"
            android:text="@string/welcome_tagline"
            android:textColor="@color/ads_on_navy"
            android:textSize="36sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_5"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_5">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLoginClient"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/welcome_create_account" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLoginWorker"
            style="@style/Widget.ADS.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/welcome_have_account" />
    </LinearLayout>
</LinearLayout>
