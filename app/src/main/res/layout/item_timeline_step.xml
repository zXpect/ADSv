<?xml version="1.0" encoding="utf-8"?>
<!-- Paso de la línea de tiempo del servicio (mockups 20, 45, 46, 55):
     punto (hecho / actual / pendiente), línea hacia el siguiente, título y descripción. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_timeline_dot"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_ads_check_off"
            android:contentDescription="@null"
            android:padding="4dp" />

        <View
            android:id="@+id/view_timeline_line"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="28dp"
            android:background="@color/ads_line" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tv_timeline_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.ADS.Subtitle"
            tools:text="Aceptada" />

        <TextView
            android:id="@+id/tv_timeline_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/sora"
            android:textAppearance="@style/TextAppearance.ADS.Label"
            android:visibility="gone"
            tools:text="Cotización aceptada por ti"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
