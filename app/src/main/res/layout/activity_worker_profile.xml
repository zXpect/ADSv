<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil del técnico · mockup 09 (docs/mockups/Perfil.dc.html). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.client.WorkerProfileActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_6">

            <ImageButton
                android:id="@+id/btn_profile_back"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/bg_ads_circle_button"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ads_text" />

            <!-- Foto o iniciales, nombre y verificación -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_3">

                <TextView
                    android:id="@+id/tv_profile_initials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ads_avatar"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                    android:textColor="@color/ads_surface"
                    android:textSize="30sp"
                    tools:text="CR" />

                <ImageView
                    android:id="@+id/iv_profile_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:accessibilityHeading="true"
                android:fontFamily="@font/sora_extrabold"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.ADS.Title"
                tools:text="Carlos Rojas" />

            <TextView
                android:id="@+id/tv_profile_verified"
                style="@style/Widget.ADS.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_2"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/profile_verified"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_check_circle"
                app:drawableTint="@color/ads_chip_text"
                tools:visibility="visible" />

            <!-- Calificación, calificaciones y distancia -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:contentPaddingBottom="@dimen/space_3"
                    app:contentPaddingLeft="@dimen/space_2"
                    app:contentPaddingRight="@dimen/space_2"
                    app:contentPaddingTop="@dimen/space_3">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_profile_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/space_1"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.ADS.Price"
                            android:textSize="18sp"
                            app:drawableStartCompat="@drawable/ic_star_filled"
                            tools:text="4,8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/sora"
                            android:text="@string/profile_rating_label"
                            android:textAppearance="@style/TextAppearance.ADS.Label" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:contentPaddingBottom="@dimen/space_3"
                    app:contentPaddingLeft="@dimen/space_2"
                    app:contentPaddingRight="@dimen/space_2"
                    app:contentPaddingTop="@dimen/space_3">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_profile_ratings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ADS.Price"
                            android:textSize="18sp"
                            tools:text="32" />

                        <TextView
                            android:id="@+id/tv_profile_ratings_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/sora"
                            android:text="@string/profile_ratings_label"
                            android:textAppearance="@style/TextAppearance.ADS.Label" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:contentPaddingBottom="@dimen/space_3"
                    app:contentPaddingLeft="@dimen/space_2"
                    app:contentPaddingRight="@dimen/space_2"
                    app:contentPaddingTop="@dimen/space_3">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_profile_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.ADS.Price"
                            android:textSize="18sp"
                            tools:text="0,8 km" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/sora"
                            android:text="@string/profile_distance_label"
                            android:textAppearance="@style/TextAppearance.ADS.Label" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Sobre mí -->
            <TextView
                android:id="@+id/tv_profile_about_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:accessibilityHeading="true"
                android:text="@string/profile_about"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong" />

            <TextView
                android:id="@+id/tv_profile_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                android:textColor="@color/ads_charcoal"
                tools:text="Electricista con experiencia en instalaciones residenciales." />

            <!-- Oficios -->
            <TextView
                android:id="@+id/tv_profile_categories_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:accessibilityHeading="true"
                android:text="@string/profile_categories"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_profile_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                app:chipSpacingHorizontal="@dimen/space_2" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra de acción fija -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ads_bar"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_line"
            android:background="@color/ads_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/screen_margin">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_request"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/request_service" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:fontFamily="@font/sora"
                android:gravity="center"
                android:text="@string/profile_request_note"
                android:textAppearance="@style/TextAppearance.ADS.Label" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
