<?xml version="1.0" encoding="utf-8"?>
<!-- Recibí el pago (trabajador) · mockup 31 (docs/mockups/RegistrarEfectivo.dc.html) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.worker.CashReceivedActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_ads_circle_button"
                    android:contentDescription="@string/action_back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/ads_text" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/Widget.ADS.StatusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/ads_navy"
                    android:text="@string/request_status_completed"
                    android:textColor="@color/ads_on_navy" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:accessibilityHeading="true"
                android:text="@string/cash_received_title"
                android:textAppearance="@style/TextAppearance.ADS.Headline" />

            <TextView
                android:id="@+id/tv_cash_received_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                tools:text="El cliente eligió pagar en efectivo." />

            <!-- Monto a recibir -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_ads_status_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_5"
                android:paddingTop="@dimen/space_6"
                android:paddingEnd="@dimen/space_5"
                android:paddingBottom="@dimen/space_6">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_ads_icon_circle">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_payment_cash"
                        app:tint="@color/ads_navy" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/cash_received_amount_label"
                    android:textAppearance="@style/TextAppearance.ADS.Caption"
                    android:textColor="@color/ads_on_navy_muted" />

                <TextView
                    android:id="@+id/tv_cash_received_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.ADS.Amount"
                    android:textColor="@color/ads_on_navy"
                    tools:text="$95.000" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/bg_ads_notice"
                android:paddingStart="@dimen/space_4"
                android:paddingTop="@dimen/space_3"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="@dimen/space_3"
                android:text="@string/cash_received_notice"
                android:textAppearance="@style/TextAppearance.ADS.Caption"
                android:textColor="@color/ads_charcoal" />
        </LinearLayout>
    </ScrollView>

    <!-- Barra de acción fija -->
    <LinearLayout
        android:id="@id/ads_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ads_bar"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_line"
            android:background="@color/ads_line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cash_received_confirm"
            style="@style/Widget.ADS.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_marginBottom="@dimen/screen_margin"
            android:text="@string/cash_received_confirm" />
    </LinearLayout>
</LinearLayout>
