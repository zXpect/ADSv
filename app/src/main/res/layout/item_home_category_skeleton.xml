<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de relleno de un oficio mientras cargan del catálogo (HomeUserActivity):
     la misma forma que item_home_category, con bloques en lugar de ícono y nombre. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:layout_margin="6dp"
    android:importantForAccessibility="no"
    app:contentPadding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_ads_skeleton_block" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="96dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_ads_skeleton_block" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
