<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context="com.ads.activities.worker.HomeWorkerActivity">

    <!-- Main Content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- App Bar con efecto elevado -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            app:elevation="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/colorPrimary"
                android:theme="@style/ToolBarTheme"
                app:title=" "
                app:titleTextColor="@color/whitevariable"
                app:layout_scrollFlags="scroll|enterAlways" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Contenido principal con scroll -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Header con gradiente y perfil -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/colorPrimary"
                    android:paddingBottom="40dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="24dp"
                        android:gravity="center_vertical"
                        app:layout_constraintTop_toTopOf="parent">

                        <!-- Avatar con borde -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_marginEnd="16dp"
                            app:cardCornerRadius="35dp"
                            app:cardElevation="8dp"
                            app:cardBackgroundColor="@color/whitevariable">

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="3dp"
                                app:cardCornerRadius="32dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/imageWorkerProfile"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_person"
                                    android:contentDescription="Foto de perfil" />

                            </androidx.cardview.widget.CardView>

                        </androidx.cardview.widget.CardView>

                        <!-- Información del usuario -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hola!"
                                android:textSize="14sp"
                                android:textColor="@color/whitevariable"
                                android:alpha="0.9"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:id="@+id/textWorkerName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cargando..."
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/whitevariable"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/badge_background"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_work"
                                    android:layout_marginEnd="6dp"
                                    app:tint="@color/whitevariable" />

                                <TextView
                                    android:id="@+id/textWorkerType"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sin especialidad"
                                    android:textSize="13sp"
                                    android:textColor="@color/whitevariable"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Cards Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="-20dp">

                    <!-- Card de Estado de Conexión (destacada) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardConnectionStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="12dp"
                        app:cardBackgroundColor="@color/whitevariable">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <!-- Header con indicador -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="16dp">

                                <!-- Indicador de estado animado -->
                                <FrameLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp">

                                    <View
                                        android:id="@+id/connectionIndicatorGlow"
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:background="@drawable/circle_glow_red"
                                        android:alpha="0.3" />

                                    <View
                                        android:id="@+id/connectionIndicator"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_gravity="center"
                                        android:background="@drawable/circle_red" />

                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Estado"
                                        android:textSize="13sp"
                                        android:textColor="@color/text_secondary"
                                        android:alpha="0.7" />

                                    <TextView
                                        android:id="@+id/textConnectionStatus"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Desconectado"
                                        android:textSize="20sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_primary" />

                                </LinearLayout>

                            </LinearLayout>

                            <!-- Mensaje informativo -->
                            <TextView
                                android:id="@+id/textConnectionMessage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Conéctate para recibir solicitudes de trabajo cercanas"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary"
                                android:lineSpacingExtra="2dp"
                                android:layout_marginBottom="16dp" />

                            <!-- Botones de acción mejorados -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/buttonConnect"
                                    android:layout_width="0dp"
                                    android:layout_height="54dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:text="Conectar"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textAllCaps="false"
                                    android:textColor="@color/whitevariable"
                                    app:cornerRadius="27dp"
                                    app:backgroundTint="@color/colorPrimary"
                                    app:icon="@drawable/ic_connect"
                                    app:iconTint="@color/whitevariable"
                                    app:iconGravity="textStart"
                                    app:iconPadding="8dp"
                                    app:iconSize="20dp"
                                    app:elevation="4dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/buttonDisconnect"
                                    android:layout_width="0dp"
                                    android:layout_height="54dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:text="Desconectar"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textAllCaps="false"
                                    android:enabled="false"
                                    android:textColor="@color/whitevariable"
                                    app:cornerRadius="27dp"
                                    app:backgroundTint="@color/error_color"
                                    app:icon="@drawable/ic_disconnect"
                                    app:iconTint="@color/whitevariable"
                                    app:iconGravity="textStart"
                                    app:iconPadding="8dp"
                                    app:iconSize="20dp"
                                    app:elevation="4dp" />

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Grid de Estadísticas - MINIMALISTA CON UN SOLO COLOR -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPerformance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@color/whitevariable">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tu Desempeño"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginBottom="16dp" />

                            <!-- Grid 2x2 de estadísticas MINIMALISTA -->
                            <GridLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:columnCount="2"
                                android:rowCount="2"
                                android:alignmentMode="alignMargins"
                                android:columnOrderPreserved="false">

                                <!-- Calificación -->
                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="6dp"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/stat_card_bg_1">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:gravity="center"
                                        android:padding="20dp">

                                        <TextView
                                            android:id="@+id/textRating"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="5.0"
                                            android:textSize="32sp"
                                            android:textStyle="bold"
                                            android:textColor="@color/stat_value_color"
                                            android:layout_marginBottom="4dp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Calificación"
                                            android:textSize="12sp"
                                            android:textColor="@color/stat_icon_color" />

                                    </LinearLayout>

                                </androidx.cardview.widget.CardView>

                                <!-- Servicios Completados -->
                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="6dp"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/stat_card_bg_2">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:gravity="center"
                                        android:padding="20dp">

                                        <TextView
                                            android:id="@+id/textCompletedServices"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="0"
                                            android:textSize="32sp"
                                            android:textStyle="bold"
                                            android:textColor="@color/stat_value_color"
                                            android:layout_marginBottom="4dp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Completados"
                                            android:textSize="12sp"
                                            android:textColor="@color/stat_icon_color" />

                                    </LinearLayout>

                                </androidx.cardview.widget.CardView>

                                <!-- Ganancias -->
                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="6dp"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/stat_card_bg_3">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:gravity="center"
                                        android:padding="20dp">

                                        <TextView
                                            android:id="@+id/textMonthlyEarnings"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="$0"
                                            android:textSize="28sp"
                                            android:textStyle="bold"
                                            android:textColor="@color/stat_value_color"
                                            android:layout_marginBottom="4dp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Ganancias"
                                            android:textSize="12sp"
                                            android:textColor="@color/stat_icon_color" />

                                    </LinearLayout>

                                </androidx.cardview.widget.CardView>

                                <!-- Servicios Activos -->
                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="6dp"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/stat_card_bg_4">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:gravity="center"
                                        android:padding="20dp">

                                        <TextView
                                            android:id="@+id/textActiveServicesCount"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="0"
                                            android:textSize="32sp"
                                            android:textStyle="bold"
                                            android:textColor="@color/stat_value_color"
                                            android:layout_marginBottom="4dp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="En Curso"
                                            android:textSize="12sp"
                                            android:textColor="@color/stat_icon_color" />

                                    </LinearLayout>

                                </androidx.cardview.widget.CardView>

                            </GridLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Card de Servicios Activos -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@color/whitevariable">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="12dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_work_active"
                                    android:layout_marginEnd="12dp"
                                    app:tint="@color/stat_value_color" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Servicios Activos"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/textActiveServices"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No hay servicios activos"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary"
                                android:paddingStart="36dp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Card de Solicitudes Pendientes (interactiva) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPendingRequests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@color/whitevariable">

                        <LinearLayout
                            android:id="@+id/layoutPendingRequests"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <!-- Badge con contador -->
                                <androidx.cardview.widget.CardView
                                    android:id="@+id/badgeNotification"
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:layout_marginEnd="12dp"
                                    app:cardCornerRadius="22dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/notification_badge_bg">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_notifications"
                                        app:tint="@color/colorPrimary" />

                                </androidx.cardview.widget.CardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Solicitudes"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_primary"
                                        android:layout_marginBottom="2dp" />

                                    <TextView
                                        android:id="@+id/textPendingRequests"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="No hay solicitudes pendientes"
                                        android:textSize="13sp"
                                        android:textColor="@color/text_secondary" />

                                </LinearLayout>

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_arrow_forward"
                                    app:tint="@color/colorPrimary" />

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Accesos Rápidos -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accesos Rápidos"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:paddingStart="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- Botón Ver Mapa -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardMapButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="@color/quick_access_bg_1">

                            <LinearLayout
                                android:id="@+id/vermapaworker"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground">

                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/ic_map"
                                    android:layout_marginBottom="12dp"
                                    app:tint="@color/stat_value_color" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ver Mapa"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <!-- Botón Fix Depot -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardFixDepotButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="@color/quick_access_bg_2">

                            <LinearLayout
                                android:id="@+id/buttonFixDepot"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp"
                                android:gravity="center"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground">

                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/ic_tools"
                                    android:layout_marginBottom="12dp"
                                    app:tint="@color/stat_value_color" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Fix Depot"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="@color/whitevariable"
        app:itemTextColor="@color/text_primary"
        app:itemIconTint="@color/text_secondary"
        app:itemBackground="@color/nav_item_background"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>