<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio del trabajador · esquema nuevo (docs/rediseno-v2): cabecera de marca, estado
     montado con interruptor, contadores sin tarjetas, mapa, próximo servicio y barra inferior. Se conservan los IDs que usa HomeWorkerActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    tools:context="com.project.ads.activities.worker.HomeWorkerActivity">

    <!-- Contenido y, encima, su esqueleto hasta que llegan los datos del trabajador -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_home_worker"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_6">

            <!-- Cabecera de marca: oficio, saludo y campana -->
            <LinearLayout
                android:id="@+id/home_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ads_brand_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_5"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="56dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textWorkerType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.ADS.Caption"
                        android:textColor="@color/ads_on_brand_header"
                        tools:text="Electricidad" />

                    <TextView
                        android:id="@+id/textWorkerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:accessibilityHeading="true"
                        android:fontFamily="@font/sora_extrabold"
                        android:textColor="@color/ads_on_brand_header"
                        android:textSize="27sp"
                        tools:text="Hola, Carlos" />
                </LinearLayout>

                <!-- Foto de perfil (si existe) -->
                <ImageView
                    android:id="@+id/imageWorkerProfile"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <include layout="@layout/view_notifications_bell" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardConnectionStatus"
                android:elevation="@dimen/ads_card_elevation"
                android:outlineSpotShadowColor="@color/ads_shadow"
                android:outlineAmbientShadowColor="@color/ads_shadow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="-30dp"
                android:layout_marginEnd="@dimen/screen_margin"
                android:background="@drawable/bg_ads_sheet_card"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Punto de estado: naranja con un anillo que late si está disponible,
                             gris si no; el cambio se anima (HomeWorkerActivity.showStatusLook) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no">

                                <View
                                    android:id="@+id/viewStatusPulse"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_gravity="center"
                                    android:alpha="0"
                                    android:background="@drawable/bg_ads_status_dot" />

                                <View
                                    android:id="@+id/viewStatusDot"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_ads_status_dot"
                                    android:backgroundTint="@color/ads_muted" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/textConnectionStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_2"
                                android:fontFamily="@font/sora_extrabold"
                                android:textColor="@color/ads_text"
                                android:textSize="19sp"
                                tools:text="Disponible" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/buttonToggleConnection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/worker_home_switch_desc"
                        android:minHeight="@dimen/touch_min"
                        app:thumbTint="@color/ads_switch_thumb"
                        app:trackDecorationTint="@android:color/transparent"
                        app:trackTint="@color/ads_switch_track" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textConnectionMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:drawablePadding="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.ADS.Caption"
                    android:textColor="@color/ads_muted"
                    tools:text="Los clientes cercanos pueden encontrarte. Tu ubicación solo se comparte mientras estés disponible." />

                <!-- Indicadores del diseño anterior (el código los sigue actualizando) -->
                <View
                    android:id="@+id/connectionIndicator"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/connectionIndicatorGlow"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin">

            <!-- Contadores: cifras sueltas, sin tarjeta -->
            <LinearLayout
                android:id="@+id/cardPendingRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/layoutPendingRequests"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_1"
                    android:paddingBottom="@dimen/space_1">

                    <TextView
                        android:id="@+id/textPendingRequests"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_extrabold"
                        android:textColor="@color/ads_text"
                        android:textSize="30sp"
                        tools:text="2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/worker_home_new_requests"
                        android:textAppearance="@style/TextAppearance.ADS.Caption" />

                    <TextView
                        android:id="@+id/badgeNotification"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutActiveServices"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_1"
                    android:paddingBottom="@dimen/space_1">

                    <TextView
                        android:id="@+id/textActiveServicesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_extrabold"
                        android:textColor="@color/ads_text"
                        android:textSize="30sp"
                        tools:text="2" />

                    <TextView
                        android:id="@+id/textActiveServices"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/worker_home_active_services"
                        android:textAppearance="@style/TextAppearance.ADS.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ver mapa: tarjeta con vista previa -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/vermapaworker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/radius_card"
                app:contentPadding="0dp"
                app:contentPaddingBottom="0dp"
                app:contentPaddingLeft="0dp"
                app:contentPaddingRight="0dp"
                app:contentPaddingTop="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:minHeight="104dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_4"
                        android:paddingTop="@dimen/space_3"
                        android:paddingEnd="@dimen/space_3"
                        android:paddingBottom="@dimen/space_3">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/worker_home_map_title"
                            android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/worker_home_map_subtitle"
                            android:textAppearance="@style/TextAppearance.ADS.Caption" />
                    </LinearLayout>

                    <!-- Vista previa: mapa dibujado y pin con un anillo que late -->
                    <FrameLayout
                        android:layout_width="124dp"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="noHideDescendants">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_ads_map_preview" />

                        <View
                            android:id="@+id/view_map_pin_ring"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:alpha="0"
                            android:background="@drawable/bg_ads_status_dot"
                            android:backgroundTint="@color/ads_brand" />

                        <ImageView
                            android:id="@+id/iv_map_pin"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/pin_cliente" />
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Próximo servicio -->
            <TextView
                android:id="@+id/tv_next_service_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:accessibilityHeading="true"
                android:text="@string/worker_home_next_service"
                android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                android:textSize="16sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_next_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_next_service_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.ADS.Subtitle"
                            tools:text="Electricidad · Laura Gómez" />

                        <TextView
                            android:id="@+id/tv_next_service_status"
                            style="@style/Widget.ADS.StatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_2"
                            tools:text="Aceptada" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_next_service_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.ADS.Caption"
                        app:drawableStartCompat="@drawable/ic_time_small"
                        app:drawableTint="@color/ads_muted"
                        tools:text="Hoy, 3:00 p. m." />

                    <TextView
                        android:id="@+id/tv_next_service_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:drawablePadding="6dp"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.ADS.Caption"
                        app:drawableStartCompat="@drawable/ic_location_small"
                        app:drawableTint="@color/ads_muted"
                        tools:text="Calle 6 # 3-15" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Próximo servicio sin servicios: aviso simple en lugar del hueco -->
            <LinearLayout
                android:id="@+id/card_next_service_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/worker_home_next_empty_title"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall.Strong" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/worker_home_next_empty_message"
                    android:textAppearance="@style/TextAppearance.ADS.Caption" />
            </LinearLayout>

            <!-- Desempeño del diseño anterior: el mockup no lo muestra -->
            <LinearLayout
                android:id="@+id/cardPerformance"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/textCompletedServices"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_home_worker_skeleton" />
    </FrameLayout>

    <include layout="@layout/view_bottom_nav_worker" />
</LinearLayout>
