<?xml version="1.0" encoding="utf-8"?>
<!-- Estado de verificación del trabajador · mockups 34 (en revisión), 35 (rechazada)
     y 36 (aprobada): VerificacionPendiente/Rechazada/Aprobada.dc.html -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ads_surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="32dp"
    tools:context="com.project.ads.activities.worker.VerificationStatusActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layout_verify_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_6"
            android:paddingBottom="@dimen/space_4"
            android:visibility="invisible">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_ads_verify_circle">

                <ImageView
                    android:id="@+id/iv_verify_icon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ads_verify_pending" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_verify_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.ADS.Headline"
                tools:text="Estamos revisando tu perfil" />

            <TextView
                android:id="@+id/tv_verify_message"
                android:layout_width="290dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                android:textColor="@color/ads_muted"
                tools:text="Te avisaremos cuando esté listo." />

            <!-- 34: línea de pasos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_verify_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:contentPaddingBottom="6dp"
                app:contentPaddingLeft="@dimen/space_5"
                app:contentPaddingRight="@dimen/space_5"
                app:contentPaddingTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/verify_dot_1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_ads_step_todo">

                        <ImageView
                            android:id="@+id/verify_check_1"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ads_check"
                            android:visibility="gone"
                            app:tint="@color/ads_surface" />
                    </FrameLayout>

                    <View
                        android:id="@+id/verify_line_1"
                        android:layout_width="2dp"
                        android:layout_height="24dp"
                        android:background="@color/ads_line" />
                </LinearLayout>

                <TextView
                    android:id="@+id/verify_label_1"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="@string/verify_step_sent"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/verify_dot_2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_ads_step_todo">

                        <ImageView
                            android:id="@+id/verify_check_2"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ads_check"
                            android:visibility="gone"
                            app:tint="@color/ads_surface" />
                    </FrameLayout>

                    <View
                        android:id="@+id/verify_line_2"
                        android:layout_width="2dp"
                        android:layout_height="24dp"
                        android:background="@color/ads_line" />
                </LinearLayout>

                <TextView
                    android:id="@+id/verify_label_2"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="@string/verify_step_review"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/verify_dot_3"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_ads_step_todo">

                        <ImageView
                            android:id="@+id/verify_check_3"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ads_check"
                            android:visibility="gone"
                            app:tint="@color/ads_surface" />
                    </FrameLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/verify_label_3"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="@string/verify_step_approved"
                    android:textAppearance="@style/TextAppearance.ADS.BodySmall" />
            </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 35: motivo del rechazo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_verify_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:visibility="gone"
                app:cardCornerRadius="18dp"
                app:contentPadding="@dimen/space_4"
                app:strokeColor="@color/ads_brand_text"
                app:strokeWidth="@dimen/stroke_focus">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/verify_reason_label"
                        android:textAppearance="@style/TextAppearance.ADS.Label"
                        android:textColor="@color/ads_chip_text" />

                    <TextView
                        android:id="@+id/tv_verify_reason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:textAppearance="@style/TextAppearance.ADS.BodySmall"
                        android:textColor="@color/ads_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 36: chip Verificado -->
            <TextView
                android:id="@+id/tv_verify_chip"
                style="@style/Widget.ADS.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:drawablePadding="5dp"
                android:text="@string/verify_chip_new"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_ads_check"
                app:drawableTint="@color/ads_chip_text" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_verify_primary"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:visibility="invisible"
        tools:text="Entendido" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_verify_secondary"
        style="@style/Widget.ADS.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="@string/verify_exit"
        android:visibility="gone" />
</LinearLayout>
