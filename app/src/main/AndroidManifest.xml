        <activity
            android:name="com.project.ads.activities.worker.RequestDetailActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.client.MapClientActivity"
            android:exported="false"
            android:theme="@style/Theme.ADSv" />
        <activity
            android:name="com.project.ads.activities.client.RegisterActivity"
            android:exported="false"
