<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Permiso para acceder a internet -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />
    <uses-permission android:name="android.permission.INTERNET" /> <!-- Permiso para notificaciones (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" /> <!-- Permisos para la cámara y galería -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name="com.project.ads.MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ADSv"
        tools:targetApi="33">
        <!--
            Pago: vuelve del checkout por adsapp://payment-result?request_id=...
            Exportada solo para el deep link; el resultado del pago se lee de
            Firebase (lo escribe el backend), no de los parámetros del enlace.
        -->
        <activity
            android:name="com.project.ads.activities.client.PaymentActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="payment-result"
                    android:scheme="adsapp" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.project.ads.activities.client.ServiceRequestDetailActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.worker.ServiceDetailWorkerActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.worker.ActiveServicesActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.client.RatingActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.client.MyRequestsActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.client.ProfileClientActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.worker.ProfileWorkerActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.worker.WorkerDocumentsActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.worker.DocumentStatusActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.worker.SecondRegisterWorkerActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.client.WebViewActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.client.ServiceSummaryActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.client.ServiceCompletionActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.client.VerifyRequestActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.client.ServiceRequestActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.worker.HomeWorkerActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.worker.FirtsRegisterWorkerActivity"
            android:exported="false"
            android:parentActivityName="com.project.ads.activities.LoginActivity" />
        <activity
            android:name="com.project.ads.activities.client.HomeUserActivity"
            android:exported="false" />
        <activity
            android:name="com.project.ads.activities.client.WorkersActivity"
            android:exported="false" />
